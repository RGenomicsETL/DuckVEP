#!/bin/sh
set -eu
cd "$(dirname "$0")"
if ! command -v cmake >/dev/null 2>&1; then
  echo 'Rduckvep requires CMake to compile its bundled extension' >&2
  exit 1
fi
extension="$(pwd)/inst/duckvep_extension"
if [ ! -f "$extension/CMakeLists.txt" ]; then
  echo 'Run Rscript r/Rduckvep/bootstrap.R <repo> before building Rduckvep' >&2
  exit 1
fi
version="$("${R_HOME}/bin/Rscript" -e 'cat(as.character(utils::packageVersion("duckdb")))')"
case "$(uname -s):$(uname -m)" in
  Linux:x86_64) platform=linux_amd64 ;;
  Linux:aarch64) platform=linux_arm64 ;;
  Darwin:x86_64) platform=osx_amd64 ;;
  Darwin:arm64) platform=osx_arm64 ;;
  *) echo 'Unsupported DuckDB extension platform' >&2; exit 1 ;;
esac
build="$(mktemp -d)"
trap 'rm -rf "$build"' EXIT HUP INT TERM
cp -R "$extension" "$build/source"
mv "$build/source/third_party/htslib/Makefile.hts" "$build/source/third_party/htslib/Makefile"
cmake -S "$build/source" -B "$build/build" -DEXTENSION_NAME=duckvep \
  -DTARGET_DUCKDB_VERSION_MAJOR="${version%%.*}" \
  -DCMAKE_BUILD_TYPE=Release
cmake --build "$build/build" --parallel 2
case "$(uname -s)" in
  Darwin) library="$build/build/libduckvep.dylib" ;;
  *) library="$build/build/libduckvep.so" ;;
esac
artifact="$(pwd)/inst/duckvep_extension/artifacts/v${version}/duckvep.duckdb_extension"
mkdir -p "$(dirname "$artifact")"
"${R_HOME}/bin/Rscript" tools/append_extension_metadata.R \
  --library-file "$library" --out-file "$artifact" \
  --extension-name duckvep --duckdb-platform "$platform" \
  --duckdb-version "v${version}" --extension-version "v${version}" \
  --abi-type C_STRUCT_UNSTABLE

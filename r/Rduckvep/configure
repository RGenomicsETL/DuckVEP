#!/bin/sh
set -eu
cd "$(dirname "$0")"
if ! command -v cmake >/dev/null 2>&1; then
  echo 'Rduckvep requires CMake to compile its bundled extension' >&2
  exit 1
fi
extension="$(pwd)/inst/duckvep_extension"
if [ ! -f "$extension/CMakeLists.txt" ]; then
  echo 'Run Rscript r/Rduckvep/bootstrap.R <repo> before building Rduckvep' >&2
  exit 1
fi
version="$("${R_HOME}/bin/Rscript" -e 'cat(as.character(utils::packageVersion("duckdb")))')"
# rwasm invokes configure through emconfigure with an Emscripten compiler.
wasm=no
host_triplet=
build_triplet=
cache_vars=
for arg in "$@"; do
  case "$arg" in
    --host=*) host_triplet=${arg#--host=} ;;
    --build=*) build_triplet=${arg#--build=} ;;
    ac_cv_*=*) cache_vars="${cache_vars}${cache_vars:+;}${arg}" ;;
  esac
done
case "${CC:-}:$host_triplet" in
  *emcc*|*wasm*|*emscripten*) wasm=yes ;;
esac
# DuckDB's Emscripten R runtime identifies itself as linux_i686_musl.
platform="${DUCKDB_PLATFORM:-}"
if [ -z "$platform" ] && [ "$wasm" = yes ]; then
  platform=linux_i686_musl
fi
if [ -z "$platform" ]; then
  case "$(uname -s):$(uname -m)" in
    Linux:x86_64) platform=linux_amd64 ;;
    Linux:aarch64) platform=linux_arm64 ;;
    Darwin:x86_64) platform=osx_amd64 ;;
    Darwin:arm64) platform=osx_arm64 ;;
    *) echo "Set DUCKDB_PLATFORM for $(uname -s) $(uname -m) builds" >&2; exit 1 ;;
  esac
fi
build="$(mktemp -d)"
trap 'rm -rf "$build"' EXIT HUP INT TERM
cp -R "$extension" "$build/source"
mv "$build/source/third_party/htslib/Makefile.hts" "$build/source/third_party/htslib/Makefile"
if [ "$(uname -s)" = Darwin ]; then
  # Use the compiler and deployment flags of the R binary that loads DuckDB.
  cc=$("${R_HOME}/bin/R" CMD config CC)
  cc=${cc%% *}
  cflags=$("${R_HOME}/bin/R" CMD config CFLAGS)
  cppflags=$("${R_HOME}/bin/R" CMD config CPPFLAGS)
  picflags=$("${R_HOME}/bin/R" CMD config CPICFLAGS)
  ldflags=$("${R_HOME}/bin/R" CMD config LDFLAGS)
  set -- "-DCMAKE_C_COMPILER=$cc" \
    "-DCMAKE_C_FLAGS=$cppflags $cflags $picflags" \
    "-DCMAKE_EXE_LINKER_FLAGS=$ldflags" \
    "-DCMAKE_SHARED_LINKER_FLAGS=$ldflags"
elif [ "$wasm" = yes ]; then
  # rwasm links packages with SIDE_MODULE=1, which exports every symbol. The
  # extension chooses SIDE_MODULE=2 and its own export list (CMakeLists.txt).
  LDFLAGS=$(printf '%s' "${LDFLAGS:-}" | sed 's/-s *SIDE_MODULE=1//g')
  set -- "-DCMAKE_TOOLCHAIN_FILE=${EMSCRIPTEN}/cmake/Modules/Platform/Emscripten.cmake" \
    "-DCMAKE_C_COMPILER=${CC:-emcc}" \
    -DDUCKDB_WASM_EXTENSION=ON -DDUCKVEP_WEBR_EXTENSION=ON \
    "-DHTSLIB_BUILD_TRIPLET=$build_triplet" \
    "-DHTSLIB_AUTOCONF_CACHE=$cache_vars" \
    "-DZLIB_LIBRARY=${EMSCRIPTEN}/cache/sysroot/lib/wasm32-emscripten/pic/libz.a" \
    "-DCMAKE_C_FLAGS=-s USE_ZLIB=1 ${CFLAGS:-}" \
    "-DCMAKE_EXE_LINKER_FLAGS=-s USE_ZLIB=1 ${LDFLAGS:-}" \
    "-DCMAKE_SHARED_LINKER_FLAGS=-s USE_ZLIB=1 ${LDFLAGS:-}"
else
  set --
fi
cmake -S "$build/source" -B "$build/build" -DEXTENSION_NAME=duckvep \
  -DTARGET_DUCKDB_VERSION_MAJOR="${version%%.*}" \
  -DCMAKE_BUILD_TYPE=Release "$@"
cmake --build "$build/build" --parallel 2
case "$(uname -s)" in
  Darwin) library="$build/build/libduckvep.dylib" ;;
  *) library="$build/build/libduckvep.so" ;;
esac
artifact="$(pwd)/inst/duckvep_extension/artifacts/v${version}/duckvep.duckdb_extension"
mkdir -p "$(dirname "$artifact")"
"${R_HOME}/bin/Rscript" tools/append_extension_metadata.R \
  --library-file "$library" --out-file "$artifact" \
  --extension-name duckvep --duckdb-platform "$platform" \
  --duckdb-version "v${version}" --extension-version "v${version}" \
  --abi-type C_STRUCT_UNSTABLE

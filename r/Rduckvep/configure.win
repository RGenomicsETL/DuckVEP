#!/bin/sh
set -eu
cd "$(dirname "$0")"
if ! command -v cmake >/dev/null 2>&1; then
  echo 'Rduckvep requires CMake to compile its bundled extension' >&2
  exit 1
fi
extension="$(pwd)/inst/duckvep_extension"
if [ ! -f "$extension/CMakeLists.txt" ]; then
  echo 'Run Rscript r/Rduckvep/bootstrap.R <repo> before building Rduckvep' >&2
  exit 1
fi
version="$("${R_HOME}/bin/Rscript" -e 'cat(as.character(utils::packageVersion("duckdb")))')"
# R CMD config selects the Rtools compiler and its platform-specific flags.
cc=$("${R_HOME}/bin/R" CMD config CC)
cc=${cc%% *}
# The shell may be x86_64 even when R and its compiler target arm64.
r_target=$("${R_HOME}/bin/Rscript" -e 'cat(R.Version()[["platform"]])')
cc_target=$($cc -dumpmachine)
case "$r_target" in
  x86_64-*) r_arch=amd64 ;;
  aarch64-*|arm64-*) r_arch=arm64 ;;
  *) echo "Unsupported Windows R target: $r_target" >&2; exit 1 ;;
esac
case "$cc_target" in
  x86_64-*) cc_arch=amd64 ;;
  aarch64-*|arm64-*) cc_arch=arm64 ;;
  *) echo "Unsupported Windows compiler target: $cc_target" >&2; exit 1 ;;
esac
if [ "$r_arch" != "$cc_arch" ]; then
  echo "R/compiler target mismatch: R=$r_target compiler=$cc_target" >&2
  exit 1
fi
# R's duckdb on Windows uses MinGW. Preserve explicit cross-build overrides.
platform="${DUCKDB_PLATFORM:-windows_${r_arch}_mingw}"
cflags=$("${R_HOME}/bin/R" CMD config CFLAGS)
cppflags=$("${R_HOME}/bin/R" CMD config CPPFLAGS)
picflags=$("${R_HOME}/bin/R" CMD config CPICFLAGS)
ldflags=$("${R_HOME}/bin/R" CMD config LDFLAGS)
build="$(mktemp -d)"
trap 'rm -rf "$build"' EXIT HUP INT TERM
cp -R "$extension" "$build/source"
mv "$build/source/third_party/htslib/Makefile.hts" "$build/source/third_party/htslib/Makefile"
cmake -G 'MSYS Makefiles' -S "$build/source" -B "$build/build" \
  -DEXTENSION_NAME=duckvep \
  -DCMAKE_BUILD_TYPE=Release "-DCMAKE_C_COMPILER=$cc" \
  "-DCMAKE_C_FLAGS=$cppflags $cflags $picflags" \
  "-DCMAKE_SHARED_LINKER_FLAGS=$ldflags"
cmake --build "$build/build" --parallel 2
artifact="$(pwd)/inst/duckvep_extension/artifacts/v${version}/duckvep.duckdb_extension"
mkdir -p "$(dirname "$artifact")"
"${R_HOME}/bin/Rscript" tools/append_extension_metadata.R \
  --library-file "$build/build/libduckvep.dll" --out-file "$artifact" \
  --extension-name duckvep --duckdb-platform "$platform" \
  --duckdb-version "v${version}" --extension-version "v${version}" \
  --abi-type C_STRUCT_UNSTABLE

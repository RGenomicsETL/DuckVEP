  "INFO_RU" VARCHAR, "FORMAT_GT" VARCHAR, "FORMAT_SO" VARCHAR, "FORMAT_REPCN" VARCHAR, "FORMAT_REPCI" VARCHAR,
  "FORMAT_CN" VARCHAR, "FORMAT_CI" VARCHAR, ref VARCHAR, alt VARCHAR, alt_index DOUBLE);

statement ok
CREATE TEMP TABLE eh_refs (event_index BIGINT, reference_sequence VARCHAR);

statement ok
INSERT INTO eh_extreme VALUES
  (0, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL),
  (1, '2008', '1', '3', 'CAG', '1/2', 'SPANNING/SPANNING', '2/10', '2-2/10-10', NULL, NULL, 'C', '<STR2>,<STR10>', 1),
  (2, NULL, '1e308', '3', 'CAG', '1/2', NULL, '2/10', NULL, NULL, NULL, 'C', '<STR2>,<STR99999999999999999999>', 2),
  (3, '2008', '1', '3', 'CAG', '1/2', NULL, '2/10', NULL, NULL, NULL, 'C', '<STR2>,<STR10>', 1e300),
  (4, '2008', '1', '3', repeat('CAG', 1000000), '1/2', NULL, '2/10', NULL, NULL, NULL, 'C', '<STR2>,<STR10>', -1),
  (5, NULL, '1', '3', 'CAG', '1/2', NULL, '2/10', NULL, NULL, NULL, 'C', '<STR2>,<STR10>', 'NaN'::DOUBLE),
  (6, NULL, '1', '3', 'CAG', '1/2', NULL, '2/10', NULL, NULL, NULL, 'C', '<STR2>,<STR10>', 9223372036854775807),
  (7, NULL, '1', '3', 'CAG', '1/2', NULL, NULL, NULL, NULL, NULL, 'C', '<STR1000000000>,<STR10>', 2),
  (NULL, NULL, '1', '3', 'CAG', '1/2', NULL, '2/10', NULL, NULL, NULL, 'C', '<STR2>,<STR10>', 1),

# name: test/sql/duckvep_builder_errors.test
# description: Error recovery for the STR, SV geometry, BND identity, BND fusion and structural HGVS builders
# group: [duckvep]

require duckvep

# Every failure below must be an explicit error and leave the session usable.

# ---- Relation names: NULL, empty, missing, oversized ------------------------------------
statement error
SELECT duckvep_prepare_sv_geometry_sql(NULL);
----
invalid relation name or allocation failure

statement error
SELECT duckvep_prepare_sv_geometry_sql('');
----
invalid relation name or allocation failure

statement error
SELECT duckvep_prepare_breakend_pairs_sql(NULL);
----
duckvep_prepare_breakend_pairs_sql: invalid relation name

statement error
SELECT duckvep_prepare_breakend_fusion_sql(NULL, 'x');
----
duckvep_prepare_breakend_fusion_sql: invalid relation name

statement error
SELECT duckvep_prepare_breakend_fusion_sql('x', NULL);
----
duckvep_prepare_breakend_fusion_sql: invalid relation name

statement error
SELECT duckvep_prepare_structural_hgvs_sql(NULL, 'x');
----
duckvep_prepare_structural_hgvs_sql: invalid relation name

statement error
SELECT duckvep_prepare_structural_hgvs_sql('x', NULL);
----
duckvep_prepare_structural_hgvs_sql: invalid relation name

statement error
SELECT duckvep_prepare_expansionhunter_sql(NULL, 'x');
----
duckvep_prepare_expansionhunter_sql: invalid relation name

statement error
SELECT duckvep_prepare_expansionhunter_sql('x', NULL);
----
duckvep_prepare_expansionhunter_sql: invalid relation name

statement error
SELECT duckvep_vcf_events_sql(NULL, 'x');
----
duckvep_vcf_events_sql: invalid relation name

statement error
SELECT duckvep_vcf_events_sql('x', NULL);
----
duckvep_vcf_events_sql: invalid relation name

# A NULL name in one row of a vector fails the statement, not the process.
statement error
SELECT duckvep_prepare_sv_geometry_sql(CASE WHEN i = 2 THEN NULL ELSE 'x' END) FROM range(4) t(i);
----
invalid relation name or allocation failure

# A one-megabyte relation name is quoted, then rejected by the catalog.
statement error
SELECT * FROM query(duckvep_prepare_sv_geometry_sql(repeat('x', 1000000)));
----
does not exist

query I
SELECT length(duckvep_prepare_breakend_pairs_sql(repeat('x', 1000000))) > 1000000;
----
1

# Missing relations reach the catalog error, one per builder.
statement error
SELECT * FROM query(duckvep_prepare_sv_geometry_sql('no_such_relation'));
----
no_such_relation

statement error
SELECT * FROM query(duckvep_prepare_breakend_pairs_sql('no_such_relation'));
----
no_such_relation

statement error
SELECT * FROM query(duckvep_prepare_expansionhunter_sql('no_such_relation', 'also_missing'));
----
no_such_relation

statement error
SELECT * FROM query(duckvep_vcf_events_sql('no_such_relation', 'also_missing'));
----
no_such_relation

statement error
SELECT * FROM query(duckvep_prepare_structural_hgvs_sql('no_such_relation', 'also_missing'));
----
no_such_relation

statement error
SELECT * FROM query(duckvep_prepare_breakend_fusion_sql('no_such_relation', 'also_missing'));
----
no_such_relation

# ---- Options -----------------------------------------------------------------------------
statement error
SELECT duckvep_prepare_sv_geometry_sql('x', 5);
----
<REGEX>:(options must be a STRUCT|duckvep_prepare_sv_geometry_sql)

statement error
SELECT duckvep_prepare_breakend_pairs_sql('x', {bogus: 1});
----
unknown option 'bogus'

statement error
SELECT duckvep_prepare_structural_hgvs_sql('x', 'y', {max_span: 'many'});
----
max_span

statement error
SELECT duckvep_prepare_structural_hgvs_sql('x', 'y', {max_span: 1, max_span: 2});
----
max_span

# ---- Wrong columns and wrong column types -----------------------------------------------
statement ok
CREATE TEMP TABLE only_index (event_index INTEGER);

statement error
SELECT * FROM query(duckvep_prepare_sv_geometry_sql('only_index'));
----
"pos" not found

statement error
SELECT * FROM query(duckvep_prepare_breakend_pairs_sql('only_index'));
----
not found

statement error
SELECT * FROM query(duckvep_prepare_structural_hgvs_sql('only_index', 'only_index'));
----
not found

statement error
SELECT * FROM query(duckvep_prepare_expansionhunter_sql('only_index', 'only_index'));
----
not found

statement ok
CREATE TEMP TABLE wrong_types (event_index VARCHAR, pos VARCHAR, ref INTEGER, alt DOUBLE, info BOOLEAN);

statement ok
INSERT INTO wrong_types VALUES ('x', 'y', 1, 2.5, true), (NULL, NULL, NULL, NULL, NULL);

# Typed input tolerates other column types: the rows come back refused, not as an error.
query IT
SELECT event_index, status FROM query(duckvep_prepare_sv_geometry_sql('wrong_types')) ORDER BY event_index NULLS FIRST;
----
NULL	unsupported_geometry
x	unsupported_geometry

# ---- NULL and empty rows produce explicit non-ok rows ------------------------------------
statement ok
CREATE TEMP TABLE sv_null (event_index BIGINT, pos BIGINT, ref VARCHAR, alt VARCHAR, "INFO_END" VARCHAR, "INFO_SVLEN" VARCHAR, "INFO_CIPOS" VARCHAR[], "INFO_CIEND" VARCHAR[], "INFO_SEQ" VARCHAR);

statement ok
INSERT INTO sv_null VALUES (0, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL),
  (1, 100, '', '', '', '', [], [], ''),
  (2, NULL, 'N', '<DEL>', '5', NULL, NULL, NULL, NULL), (3, 100, 'N', '<DEL>', 'x', NULL, NULL, NULL, NULL),
  (4, 100, 'N', '<DEL>', '200', NULL, ['1', '2', '3'], NULL, NULL), (NULL, 100, 'N', '<DEL>', '200', NULL, NULL, NULL, NULL);

query IT
SELECT event_index, status FROM query(duckvep_prepare_sv_geometry_sql('sv_null')) ORDER BY event_index NULLS FIRST;
----
NULL	ok
0	unsupported_geometry
1	unsupported_geometry
2	unsupported_geometry
3	unsupported_geometry
4	unsupported_geometry

# ---- Extreme values never overflow the whole statement -----------------------------------
statement ok
CREATE TEMP TABLE sv_extreme (event_index BIGINT, pos BIGINT, ref VARCHAR, alt VARCHAR, "INFO_END" VARCHAR, "INFO_SVLEN" VARCHAR, "INFO_CIPOS" VARCHAR[], "INFO_CIEND" VARCHAR[], "INFO_SEQ" VARCHAR);

statement ok
INSERT INTO sv_extreme VALUES
  (0, 9223372036854775807, 'N', '<DEL>', '9223372036854775807', NULL, NULL, NULL, NULL),
  (1, -9223372036854775808, 'N', '<DEL>', '5', NULL, NULL, NULL, NULL),
  (2, -9223372036854775808, '', '<DEL>', '5', NULL, NULL, NULL, NULL),
  (3, 100, 'N', '<DEL>', '99999999999999999999999999', NULL, NULL, NULL, NULL),
  (4, 100, 'N', '<DEL>', '200', NULL, ['-9223372036854775808', '9223372036854775807'], NULL, NULL),
  (5, 100, 'N', '<DEL>', '2147483647', NULL, NULL, ['0', '9223372036854775807'], NULL),
  (6, 2147483647, 'N', '<DEL>', '2147483647', NULL, NULL, NULL, NULL),
  (7, 100, repeat('A', 100000), repeat('C', 100000), NULL, repeat('9', 100000), NULL, NULL, NULL),
  (8, 1, 'N', '<INS>', '1', NULL, NULL, NULL, repeat('A', 1000000));

query IT
SELECT event_index, status FROM query(duckvep_prepare_sv_geometry_sql('sv_extreme')) ORDER BY event_index;
----
0	unsupported_geometry
1	unsupported_geometry
2	unsupported_geometry
3	unsupported_geometry
4	unsupported_geometry
5	unsupported_geometry
6	unsupported_geometry
7	unsupported_geometry
8	ok

query I
SELECT length(source_sequence) FROM query(duckvep_prepare_sv_geometry_sql('sv_extreme')) WHERE event_index = 8;
----
1000000

# ---- BND identity ----------------------------------------------------------------------------
statement ok
CREATE TEMP TABLE bnd_extreme (event_index BIGINT, chrom VARCHAR, pos BIGINT, id VARCHAR,
  ref VARCHAR, alt VARCHAR, "INFO_MATEID" VARCHAR[]);

statement ok
INSERT INTO bnd_extreme VALUES
  (0, NULL, NULL, NULL, NULL, NULL, NULL),
  (1, '1', 9223372036854775807, 'a', 'N', 'N[1:9223372036854775807[', ['b']),
  (2, '1', 1, 'b', 'N', ']1:9223372036854775807]N', ['a']),
  (3, '1', 5, 'c', 'N', 'N[1:' || repeat('9', 1000) || '[', ['c']),
  (4, '1', 5, repeat('i', 100000), 'N', 'N[[', ['']),
  (5, '1', 5, 'q', 'N', '[[[[[', ['q', 'q']),
  (6, '1', -5, 'r', 'N', 'N[1:-5[', []),
  (NULL, '1', 5, 'z', 'N', 'N[1:5[', ['z']);

query IT
SELECT event_index, status FROM query(duckvep_prepare_breakend_pairs_sql('bnd_extreme')) ORDER BY event_index NULLS FIRST;
----
NULL	conflict
0	not_applicable
1	conflict
2	conflict
3	invalid
4	invalid
5	invalid
6	invalid

statement ok
CREATE TEMP TABLE bnd_pairs_extreme AS SELECT * FROM query(duckvep_prepare_breakend_pairs_sql('bnd_extreme'));

statement ok
CREATE TEMP TABLE bnd_genes_extreme (event_index BIGINT, gene_id VARCHAR);

statement ok
INSERT INTO bnd_genes_extreme VALUES (NULL, NULL), (1, NULL), (2, 'g'), (1, 'g'), (1, 'g'),
  (9999999999, repeat('g', 100000));

query IT
SELECT event_index, status FROM query(duckvep_prepare_breakend_fusion_sql('bnd_pairs_extreme',
  'bnd_genes_extreme')) ORDER BY event_index NULLS FIRST;
----
NULL	identity_unproven
0	identity_unproven
1	identity_unproven
2	identity_unproven
3	identity_unproven
4	identity_unproven
5	identity_unproven
6	identity_unproven

query I
SELECT count(*) FILTER (WHERE fusion_asserted) FROM query(duckvep_prepare_breakend_fusion_sql(
  'bnd_pairs_extreme', 'bnd_genes_extreme'));
----
0

# ---- Structural HGVS ----------------------------------------------------------------------------
statement ok
CREATE TEMP TABLE hg_events (event_index BIGINT, chrom VARCHAR, pos BIGINT, ref VARCHAR,
  alt VARCHAR, "INFO_END" VARCHAR);

statement ok
CREATE TEMP TABLE hg_refs (event_index BIGINT, reference_sequence VARCHAR);

statement ok
INSERT INTO hg_events VALUES
  (0, NULL, NULL, NULL, NULL, NULL),
  (1, '1', 9223372036854775807, 'N', '<DEL>', '9223372036854775807'),
  (2, '1', -9223372036854775808, 'N', '<DEL>', '5'),
  (3, '1', 100, 'N', '<DEL>', '99999999999999999999999999'),
  (4, '1', 100, 'N', '<DUP>', '200'),
  (5, '1', 100, 'N', '<INV>', '101'),
  (6, '1', 1, 'N', '<DEL>', '2147483647'),
  (7, '1', 100, repeat('A', 100000), repeat('C', 100000), repeat('9', 100000)),
  (NULL, '1', 100, 'N', '<DEL>', '101'),
  (9, '1', 100, '', '', ''),
  (10, '1', 100, 'N', '<DEL>', '101,102'),
  (11, '1', 100, 'N', '<DEL>', '101');

statement ok
INSERT INTO hg_refs VALUES (0, NULL), (1, 'ACGT'), (3, repeat('A', 10000000)), (4, repeat('A', 10)),
  (5, 'ACGT'), (7, NULL), (NULL, 'AC'), (9, ''), (11, 'AC'), (11, 'AC');

query IT
SELECT event_index, hgvs_status FROM query(duckvep_prepare_structural_hgvs_sql('hg_events', 'hg_refs'))
ORDER BY event_index NULLS FIRST;
----
NULL	unavailable
0	unavailable
1	unavailable
2	unavailable
3	unavailable
4	unavailable
5	unavailable
6	unsupported
7	unsupported
9	unsupported
10	unavailable
11	unavailable

query I
SELECT count(*) FILTER (WHERE hgvs_g IS NOT NULL) FROM query(
  duckvep_prepare_structural_hgvs_sql('hg_events', 'hg_refs'));
----
0

# ---- ExpansionHunter ------------------------------------------------------------------------------

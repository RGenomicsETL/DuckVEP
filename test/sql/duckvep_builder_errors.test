1	ok
2	incomplete
3	incomplete
4	incomplete
5	incomplete
6	incomplete
7	incomplete
8	incomplete
9	incomplete

# ---- Recovery: the failures above left every builder usable --------------------------------------
statement ok
CREATE TEMP TABLE recover_sv (event_index INTEGER, pos INTEGER, ref VARCHAR, alt VARCHAR, "INFO_END" VARCHAR, "INFO_SVLEN" VARCHAR, "INFO_CIPOS" VARCHAR[], "INFO_CIEND" VARCHAR[], "INFO_SEQ" VARCHAR);

statement ok
INSERT INTO recover_sv VALUES (0, 100, 'N', '<DEL>', '200', NULL, ['-2', '3'], NULL, NULL);

query IIIII
SELECT status, nominal_start, nominal_end, outer_start, inner_start
FROM query(duckvep_prepare_sv_geometry_sql('recover_sv'));
----
ok	101	200	99	104

query I
SELECT count(*) FROM (SELECT duckvep_prepare_breakend_pairs_sql('recover_sv') FROM range(1000));
----
1000

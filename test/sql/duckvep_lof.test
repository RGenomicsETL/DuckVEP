# ANC_ALLELE: SNVs whose alternate allele is the ancestral base; uncovered SNVs are reported unchecked
query ITTT
SELECT event_index, lof, lof_filter, lof_unchecked FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref', {ancestor: 'lof_ancestor'})) WHERE event_index IN (5, 12, 14, 17, 30) ORDER BY event_index, transcript_index
----
5	LC	SMALL_INTRON,5UTR_SPLICE	ANC_ALLELE
12	HC	NULL	NULL
14	HC	NULL	ANC_ALLELE
17	LC	ANC_ALLELE	GERP_END_TRUNC,PHYLOCSF
30	LC	ANC_ALLELE	GERP_END_TRUNC,PHYLOCSF

# PhyloCSF flags and info
query ITTTT
SELECT event_index, lof, lof_filter, lof_flags, lof_info FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref', {phylocsf: 'lof_phylocsf'})) WHERE event_index IN (1, 3, 4, 17, 28) ORDER BY event_index, transcript_index
----
1	LC	END_TRUNC	PHYLOCSF_WEAK	PERCENTILE:0.745454545454545,BP_DIST:83,DIST_FROM_LAST_EXON:49,50_BP_RULE:FAIL,ANN_ORF:-0.5,MAX_ORF:-0.1
3	HC	NULL	PHYLOCSF_WEAK	PERCENTILE:0.739393939393939,BP_DIST:85,DIST_FROM_LAST_EXON:51,50_BP_RULE:PASS,ANN_ORF:-0.5,MAX_ORF:-0.1
4	LC	END_TRUNC	NULL	PERCENTILE:0.939393939393939,BP_DIST:20,DIST_FROM_LAST_EXON:-14,50_BP_RULE:FAIL,PHYLOCSF_TOO_SHORT
17	HC	NULL	PHYLOCSF_UNLIKELY_ORF	PERCENTILE:0.503030303030303,BP_DIST:162,DIST_FROM_LAST_EXON:128,50_BP_RULE:PASS,ANN_ORF:-1.5,MAX_ORF:2
28	LC	END_TRUNC	SINGLE_EXON	PERCENTILE:0.506329113924051,BP_DIST:39,DIST_FROM_LAST_EXON:-49,50_BP_RULE:FAIL,PHYLOCSF_TOO_SHORT

# Builder contract
query I
SELECT contains(duckvep_lof_sql('a";λ', 't";λ', 'r";λ', {gerp: 'g";λ'}), '"a"";λ"')
    AND contains(duckvep_lof_sql('a";λ', 't";λ', 'r";λ', {gerp: 'g";λ'}), '"g"";λ"');
----
true

query I
SELECT duckvep_lof_sql('a', 't', 'r') = duckvep_lof_sql('a', 't', 'r', {gerp: NULL, ancestor: NULL, phylocsf: NULL,
    min_intron_size: NULL, gerp_end_trunc_cutoff: NULL, check_complete_cds: NULL});
----
true

statement error
SELECT duckvep_lof_sql(NULL, 't', 'r');
----
duckvep_lof_sql: invalid relation name

statement error
SELECT duckvep_lof_sql('a', 't', '');
----
duckvep_lof_sql: invalid relation name

statement error
SELECT duckvep_lof_sql('a', 't', 'r', {bogus: 1});
----
unknown option 'bogus'

statement error
SELECT duckvep_lof_sql('a', 't', 'r', {gerp: 1});
----
expected VARCHAR for option 'gerp'

statement error
SELECT duckvep_lof_sql('a', 't', 'r', {min_intron_size: -1});
----
min_intron_size must be an integer

statement error
SELECT duckvep_lof_sql('a', 't', 'r', {min_intron_size: 'x'});
----
expected INTEGER for option 'min_intron_size'

statement error
SELECT duckvep_lof_sql('a', 't', 'r', {gerp_end_trunc_cutoff: 'NaN'::DOUBLE});
----
gerp_end_trunc_cutoff must be a finite number

statement error
SELECT duckvep_lof_sql('a', 't', 'r', {check_complete_cds: 1});
----
expected BOOLEAN for option 'check_complete_cds'

statement error
SELECT * FROM query(duckvep_lof_sql('no_such_annotations', 'lof_tx', 'lof_ref'));
----
no_such_annotations

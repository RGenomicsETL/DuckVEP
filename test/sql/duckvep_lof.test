query ITTT
SELECT event_index, lof, lof_filter, lof_info FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref', {gerp: 'lof_gerp_pos', gerp_end_trunc_cutoff: 50})) WHERE event_index IN (1, 3) ORDER BY event_index, transcript_index

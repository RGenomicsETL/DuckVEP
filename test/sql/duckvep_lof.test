# Which checks could not run: no resource (rows 1, 5, 17), no exon geometry for the transcript (31, 32)
query ITT
SELECT event_index, lof, lof_unchecked FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref')) WHERE event_index IN (1, 5, 12, 17, 31, 32) ORDER BY event_index, transcript_index
----
1	LC	GERP_END_TRUNC,PHYLOCSF
5	LC	ANC_ALLELE
12	HC	NULL
17	HC	GERP_END_TRUNC,PHYLOCSF,ANC_ALLELE
31	HC	END_TRUNC,PHYLOCSF
32	HC	SMALL_INTRON,GC_TO_GT_DONOR,ANC_ALLELE,NON_CAN_SPLICE

# Intron size threshold: strict less-than, both strands
query ITT
SELECT event_index, lof, lof_filter FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref', {min_intron_size: 16})) WHERE event_index IN (5, 6, 7, 8, 23, 25, 26, 27) ORDER BY event_index, transcript_index
----
5	LC	SMALL_INTRON,5UTR_SPLICE
6	LC	SMALL_INTRON
7	HC	NULL
8	LC	SMALL_INTRON
23	LC	SMALL_INTRON,GC_TO_GT_DONOR
25	HC	NULL
26	HC	NULL
27	LC	SMALL_INTRON

query ITT
SELECT event_index, lof, lof_filter FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref', {min_intron_size: 17})) WHERE event_index IN (5, 6, 7, 8, 23, 25, 26, 27) ORDER BY event_index, transcript_index
----
5	LC	SMALL_INTRON,5UTR_SPLICE
6	LC	SMALL_INTRON
7	LC	SMALL_INTRON
8	LC	SMALL_INTRON
23	LC	SMALL_INTRON,GC_TO_GT_DONOR
25	LC	SMALL_INTRON
26	LC	SMALL_INTRON
27	LC	SMALL_INTRON

query ITT
SELECT event_index, lof, lof_filter FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref', {min_intron_size: 0})) WHERE event_index IN (5, 9) ORDER BY event_index, transcript_index
----
5	LC	5UTR_SPLICE
9	LC	5UTR_SPLICE

# INCOMPLETE_CDS follows cds_start_NF or cds_end_NF when asked for
query ITT
SELECT event_index, lof, lof_filter FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref', {check_complete_cds: true})) WHERE event_index IN (17, 30) ORDER BY event_index, transcript_index
----
17	HC	NULL
30	LC	INCOMPLETE_CDS

# GERP-weighted END_TRUNC: the filter needs the weighted distance to be at most the cutoff
query ITTTT
SELECT event_index, lof, lof_filter, lof_info, lof_unchecked FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref', {gerp: 'lof_gerp_neg'})) WHERE event_index IN (1, 3, 4, 20, 28) ORDER BY event_index, transcript_index
----
1	LC	END_TRUNC	PERCENTILE:0.745454545454545,GERP_DIST:-85,BP_DIST:83,DIST_FROM_LAST_EXON:49,50_BP_RULE:FAIL	PHYLOCSF
3	HC	NULL	PERCENTILE:0.739393939393939,GERP_DIST:-87,BP_DIST:85,DIST_FROM_LAST_EXON:51,50_BP_RULE:PASS	PHYLOCSF
4	HC	NULL	PERCENTILE:0.939393939393939,GERP_DIST:-21,BP_DIST:20,DIST_FROM_LAST_EXON:-14,50_BP_RULE:FAIL	PHYLOCSF
20	LC	END_TRUNC	PERCENTILE:0.604,GERP_DIST:-100,BP_DIST:98,DIST_FROM_LAST_EXON:49,50_BP_RULE:FAIL	PHYLOCSF
28	HC	NULL	PERCENTILE:0.506329113924051,GERP_DIST:-40,BP_DIST:39,DIST_FROM_LAST_EXON:-49,50_BP_RULE:FAIL	PHYLOCSF

query ITTT
SELECT event_index, lof, lof_filter, lof_info FROM query(duckvep_lof_sql('lof_ann', 'lof_tx', 'lof_ref', {gerp: 'lof_gerp_pos'})) WHERE event_index IN (1, 2, 20) ORDER BY event_index, transcript_index
----
1	HC	NULL	PERCENTILE:0.745454545454545,GERP_DIST:42.5,BP_DIST:83,DIST_FROM_LAST_EXON:49,50_BP_RULE:FAIL

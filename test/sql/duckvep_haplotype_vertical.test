require duckvep

# Same-codon and frame/stop-gain classifiers against the slice-1 vertical fixtures (test/data/haplotype/vertical.*):
# the base-R goldens in vertical_goldens.tsv decide cis (synonymous), trans (two missense lanes), frame_open,
# restored_before_stop, restored_after_stop, the stop-gain cases (nmd49/50/51, intronless, shifted_junction) and, since
# slice 5, start_lost, stop_lost and stop_retained. Nothing is left pending. The model is derived from vertical.fa/vertical.gff3 by test/scripts/generate_haplotype_models.R.

statement ok
CREATE TABLE vt_tx AS SELECT seq_region::UINTEGER transcript_index,seq_region::UINTEGER seq_region,
 transcript_start::UBIGINT transcript_start,transcript_end::UBIGINT transcript_end,strand::TINYINT strand,
 seq_region::UINTEGER gene_index,3::UBIGINT transcript_flags,transcript_start::UBIGINT cds_start,
 transcript_end::UBIGINT cds_end,cds_sequence::BLOB cds_sequence,1::UTINYINT codon_table,
 ''::BLOB pre_cds_sequence,''::BLOB post_cds_sequence,"case" AS case_name
 FROM read_csv('test/data/haplotype/vertical_transcripts.tsv',delim='\t',header=true);

statement ok
CREATE TABLE vt_exons AS SELECT seq_region::UINTEGER transcript_index,exon_start::UBIGINT exon_start,
 exon_end::UBIGINT exon_end,exon_cdna_start::UBIGINT exon_cdna_start,exon_cdna_end::UBIGINT exon_cdna_end,
 phase::TINYINT phase,end_phase::TINYINT end_phase
 FROM read_csv('test/data/haplotype/vertical_exons.tsv',delim='\t',header=true);

query I
SELECT loaded FROM duckvep_model_load('vt','SELECT i::UINTEGER seq_region FROM range(13) t(i)',
 'SELECT * EXCLUDE(case_name) FROM vt_tx ORDER BY transcript_index',
 'SELECT * FROM vt_exons ORDER BY transcript_index,exon_cdna_start');
----
1

statement ok
CREATE TABLE vt_vcf AS SELECT string_split(line,chr(9)) f FROM (SELECT unnest(string_split(content,chr(10))) line
 FROM read_text('test/data/haplotype/vertical.vcf')) WHERE line<>'' AND NOT starts_with(line,'#');

statement ok
CREATE TABLE vt_calls AS SELECT (row_number() OVER ())::BIGINT event_index,t.seq_region::INT seq_region,
 v.f[2]::BIGINT AS position,v.f[4] AS reference,v.f[5] AS alternate,1 AS alt_index,t.transcript_index::INT transcript_index,
 0 sample_index,(CASE v.f[10] WHEN '1|0' THEN [1,0] WHEN '0|1' THEN [0,1] ELSE [1,1] END)::INTEGER[] alleles,
 [false,true]::BOOLEAN[] phase_before,NULL::BIGINT phase_set
 FROM vt_vcf v JOIN vt_tx t ON t.case_name=v.f[1];

statement ok
CREATE TABLE vt_gold AS SELECT g."case" AS case_name,t.transcript_index,g.lane,g.so_terms
 FROM read_csv('test/data/haplotype/vertical_goldens.tsv',delim='\t',header=true,nullstr='<none>',
  types={'so_terms':'VARCHAR'}) g JOIN vt_tx t ON t.case_name=g."case";

statement ok
CREATE TABLE vt_out AS SELECT h.transcript_index,c.haplotype_lane-1 AS lane,h.prediction_status,h.prediction_reason,
 h.haplotype_consequences,h.haplotype_impact
 FROM (SELECT *,unnest(carriers) c FROM duckvep_haplotypes('SELECT * FROM vt_calls','vt')) h;

# Decided lanes equal the goldens exactly. Slice 4 transitions from pending: frame_open, restored_before_stop,
# restored_after_stop, nmd49, nmd50, nmd51, intronless and shifted_junction. Slice 5 transitions from pending:
# start_lost, stop_lost and stop_retained (the last three rows, listed by name in the sort).

query TITTT
SELECT g.case_name,o.lane,o.prediction_status,array_to_string(o.haplotype_consequences,','),
 o.haplotype_impact||'/'||(list_sort(o.haplotype_consequences)=list_sort(string_split(g.so_terms,',')))
FROM vt_gold g JOIN vt_out o ON o.transcript_index=g.transcript_index AND o.lane=g.lane
WHERE o.prediction_status='predicted' ORDER BY 1,2;
----
cis	0	predicted	synonymous_variant	LOW/true
frame_open	0	predicted	stop_gained,frameshift_variant	HIGH/true
intronless	0	predicted	stop_gained	HIGH/true
nmd49	0	predicted	stop_gained	HIGH/true
nmd50	0	predicted	stop_gained	HIGH/true
nmd51	0	predicted	stop_gained	HIGH/true
restored_after_stop	0	predicted	stop_gained,frameshift_variant	HIGH/true
restored_before_stop	0	predicted	protein_altering_variant	MODERATE/true
shifted_junction	0	predicted	stop_gained	HIGH/true
start_lost	0	predicted	start_lost	HIGH/true
stop_lost	0	predicted	stop_lost	HIGH/true
stop_retained	0	predicted	stop_retained_variant	LOW/true
trans	0	predicted	missense_variant	MODERATE/true
trans	1	predicted	missense_variant	MODERATE/true

# No carrier lane is pending any more: every eligible path is decided, none with a NULL SO set or IMPACT.

query I
SELECT count(*) FROM vt_out WHERE prediction_status='eligible_classifier_pending' OR prediction_reason='start_stop_classifier_pending'
 OR (prediction_status='predicted' AND (haplotype_consequences IS NULL OR haplotype_impact IS NULL));
----
0

query II
SELECT count(*) FILTER (WHERE g.so_terms=''),count(*) FILTER (WHERE g.so_terms='' AND o.lane IS NOT NULL)
FROM vt_gold g LEFT JOIN vt_out o ON o.transcript_index=g.transcript_index AND o.lane=g.lane;
----
12	0

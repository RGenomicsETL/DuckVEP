# name: test/sql/duckvep_model_generation.test
# description: Annotation refuses a model dropped and reloaded under its name while the query ran
# group: [duckvep]

require duckvep

statement ok
CREATE TABLE gen_regions AS SELECT * FROM (VALUES (0::UINTEGER), (1::UINTEGER)) t(seq_region);

statement ok
CREATE TABLE gen_transcripts AS SELECT 0::UINTEGER transcript_index, 1::UINTEGER seq_region,
  100::UBIGINT transcript_start, 250::UBIGINT transcript_end, 1::TINYINT strand,
  0::UINTEGER gene_index, 3::UBIGINT transcript_flags,
  120::UBIGINT cds_start, 240::UBIGINT cds_end,
  'ATGGTACGTACGTACGTACGTACGTACGTACTACGTACGTACGTACGTACGTACGTACGTACGTACTGGTAA'::BLOB cds_sequence,
  1::UTINYINT codon_table,
  'TACGTACGTACGTACGTACG'::BLOB pre_cds_sequence,
  'ACGTACGTAC'::BLOB post_cds_sequence;

statement ok
CREATE TABLE gen_exons AS SELECT * FROM (VALUES
  (0::UINTEGER, 100::UBIGINT, 150::UBIGINT, 1::UBIGINT, 51::UBIGINT, 0::TINYINT, 0::TINYINT),
  (0::UINTEGER, 200::UBIGINT, 250::UBIGINT, 52::UBIGINT, 102::UBIGINT, 0::TINYINT, 0::TINYINT)
) t(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end, phase, end_phase);

statement ok
CREATE TABLE gen_events AS SELECT 1::UBIGINT event_index, 1::UINTEGER seq_region,
  124::UBIGINT AS position, 'T' reference, 'C' alternate, NULL::UBIGINT end_position,
  NULL::VARCHAR structural_type, NULL::VARCHAR copy_change, NULL::UINTEGER mate_seq_region,
  NULL::UBIGINT mate_position;

query I
SELECT _duckvep_model_generation('gen') IS NULL;
----
true

statement ok
SELECT loaded FROM duckvep_model_load('gen',
  'SELECT * FROM gen_regions ORDER BY seq_region',
  'SELECT * FROM gen_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM gen_exons ORDER BY transcript_index, exon_start');

statement ok
SET VARIABLE gen_started = (SELECT _duckvep_model_generation('gen'));

query I
SELECT count(*) FROM query(duckvep_annotate_sql('gen_events', 'gen'));
----
1

statement ok
SELECT duckvep_model_drop('gen');

statement ok
SELECT loaded FROM duckvep_model_load('gen',
  'SELECT * FROM gen_regions ORDER BY seq_region',
  'SELECT * FROM gen_transcripts ORDER BY seq_region, transcript_start',
  'SELECT * FROM gen_exons ORDER BY transcript_index, exon_start');

query I
SELECT _duckvep_model_generation('gen') > getvariable('gen_started');
----
true

# A fresh query reads the new generation and annotates as before.
query I
SELECT count(*) FROM query(duckvep_annotate_sql('gen_events', 'gen'));
----
1

# A query that read the generation before the reload sees the replacement and stops.
statement error
SELECT count(*) FROM query(replace(duckvep_annotate_sql('gen_events', 'gen'),
  '_duckvep_model_generation(CAST(''gen'' AS VARCHAR))', getvariable('gen_started')::VARCHAR));
----
the model was dropped or reloaded while the query ran

statement error
SELECT count(*) FROM query(replace(duckvep_annotate_projected_sql('gen_events', 'gen'),
  '_duckvep_model_generation(CAST(''gen'' AS VARCHAR))', getvariable('gen_started')::VARCHAR));
----
the model was dropped or reloaded while the query ran

# Dropped and not reloaded: the started query is refused the same way, not as an unknown model.
statement ok
SELECT duckvep_model_drop('gen');

statement error
SELECT count(*) FROM query(replace(duckvep_annotate_sql('gen_events', 'gen'),
  '_duckvep_model_generation(CAST(''gen'' AS VARCHAR))', getvariable('gen_started')::VARCHAR));
----
the model was dropped or reloaded while the query ran

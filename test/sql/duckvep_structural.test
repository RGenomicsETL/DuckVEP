# max_span bounds the description; the option is validated.
query II
SELECT event_index, hgvs_reason FROM query(duckvep_prepare_structural_hgvs_sql(
  'sv";λ', 'ref";λ', {max_span: 2})) WHERE event_index IN (0, 4, 11);
----
0	span_capacity
4	NULL
11	span_capacity

statement error
SELECT duckvep_prepare_structural_hgvs_sql('sv', 'ref', {max_span: 0});
----
option 'max_span' must be between 1 and 60000

statement error
SELECT duckvep_prepare_structural_hgvs_sql('sv', 'ref', {max_span: 'x'});
----
expected INTEGER for option 'max_span'

statement error
SELECT duckvep_prepare_structural_hgvs_sql('sv', 'ref', {bogus: 1});
----
unknown option 'bogus'

query II
SELECT contains(duckvep_prepare_structural_hgvs_sql('sv";λ', 'ref";λ'), '"ref"";λ"'),
 duckvep_prepare_structural_hgvs_sql('sv";λ', 'ref";λ') =
 duckvep_prepare_structural_hgvs_sql('sv";λ', 'ref";λ');
----
1	1

# 40,000 physical records (20,000 reciprocal pairs) resolve through hash joins, not a
# nested loop; the previous plan was quadratic in the record count (50,000 pairs took 16 s).
statement ok
CREATE TEMP TABLE bnd_scale AS
SELECT (2 * p)::BIGINT AS event_index, '1' AS chrom, (1000 + 3 * p)::BIGINT AS pos, 'a' || p AS id, 'N' AS ref,
  'N[2:' || (500 + 3 * p) || '[' AS alt, ['b' || p] AS "INFO_MATEID", ['e' || p] AS "INFO_EVENT" FROM range(20000) t(p)
UNION ALL
SELECT (2 * p + 1)::BIGINT, '2', (500 + 3 * p)::BIGINT, 'b' || p, 'N',
  ']1:' || (1000 + 3 * p) || ']N', ['a' || p], ['e' || p] FROM range(20000) t(p);

query III
SELECT count(*), count(*) FILTER (WHERE status = 'reciprocal'), count(DISTINCT pair_key)
FROM query(duckvep_prepare_breakend_pairs_sql('bnd_scale'));
----
40000	40000	20000

# Structural HGVS. The reference relation is FASTA[pos..END], plus an equal-length
# following flank for duplications.
statement ok
CREATE TEMP TABLE "sv"";λ" (event_index INTEGER, chrom VARCHAR, pos DOUBLE, ref VARCHAR,
  alt VARCHAR, "INFO_END" BIGINT, "INFO_SVLEN" INTEGER[], "INFO_CIPOS" INTEGER[]);


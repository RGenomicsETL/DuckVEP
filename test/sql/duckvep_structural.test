# name: test/sql/duckvep_structural.test
# description: BND record identity, breakend gene evidence and structural HGVS builders
# group: [duckvep]

require duckvep

# A NULL breakend STRUCT row must have NULL children: TRY copies the vector.
query IIII
SELECT count(*), count(*) FILTER (WHERE g IS NULL),
  count(*) FILTER (WHERE g.mate_chrom IS NULL),
  count(*) FILTER (WHERE g.replacement_sequence = 'A')
FROM (SELECT TRY(duckvep_breakend_geometry(alt)) g FROM (VALUES
  ('<DEL>'), ('A'), (NULL), ('N[1:5['), ('.A'), ('N[1:5')) t(alt));
----
6	4	5	1

statement ok
CREATE TEMP TABLE "bnd"";λ" (event_index INTEGER, chrom VARCHAR, pos BIGINT, id VARCHAR,
  ref VARCHAR, alt VARCHAR, "INFO_MATEID" VARCHAR[], "INFO_EVENT" VARCHAR[]);


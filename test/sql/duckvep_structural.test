# Identifiers stay verbatim: an ID and MATEID of "1.0" still pair, and EVENT "1" and
# "1.0" stay distinct. Only numeric fields drop a zero fraction.
statement ok
CREATE TEMP TABLE bnd_text_ids AS SELECT * FROM (VALUES
  (0, '1', 100::BIGINT, '1.0', ['ATT[2:200['], ['2.0'], '1'),
  (1, '2', 200, '2.0', [']1:100]AAC'], ['1.0'], '1.0')
) t(event_index, "CHROM", "POS", "ID", "ALT", "INFO_MATEID", "INFO_EVENT");

query ITTTT
SELECT event_index, status, reason, mate_id, event_id
FROM query(duckvep_prepare_breakend_pairs_sql('bnd_text_ids')) ORDER BY event_index;
----
0	conflict	event_conflict	2.0	1
1	conflict	event_conflict	1.0	1.0

query II
SELECT contains(duckvep_prepare_breakend_pairs_sql('bnd";λ'), '"bnd"";λ"'),
 duckvep_prepare_breakend_pairs_sql('bnd";λ') = duckvep_prepare_breakend_pairs_sql('bnd";λ');
----
1	1

statement error
SELECT duckvep_prepare_breakend_pairs_sql('bnd', {bogus: 1});
----
unknown option 'bogus'

statement error
SELECT duckvep_prepare_breakend_pairs_sql(NULL);
----
invalid relation name or allocation failure

# Physical records survive: a numeric event_index and position are accepted and
# the mate is never merged into its partner.
query IIIIII
SELECT count(*), count(DISTINCT event_index), count(*) FILTER (WHERE status = 'reciprocal'),
  count(*) FILTER (WHERE status = 'conflict'), count(*) FILTER (WHERE status = 'unproven'),
  count(*) FILTER (WHERE fusion_status = 'not_asserted' AND phase_status = 'not_evaluated')
FROM query(duckvep_prepare_breakend_pairs_sql('bnd";λ'));
----
37	37	6	23	5	37

statement ok
CREATE TEMP TABLE "pairs"";λ" AS SELECT * FROM query(duckvep_prepare_breakend_pairs_sql('bnd";λ'));

statement ok
CREATE TEMP TABLE "genes"";λ" AS SELECT * FROM (VALUES
  (0, 'G1'), (1, 'G2'), (1, 'G2'), (21, 'G5'), (22, 'G6'), (33, 'G3'), (34, 'G3'),
  (35, 'G4'), (2, 'G7')) t(event_index, gene_id);

query IIIIIII
SELECT event_index, mate_event_index, status, reason, endpoint_genes, mate_endpoint_genes, fusion_asserted
FROM query(duckvep_prepare_breakend_fusion_sql('pairs";λ', 'genes";λ'))
WHERE event_index IN (0, 1, 2, 3, 21, 22, 33, 35, 36) ORDER BY event_index;

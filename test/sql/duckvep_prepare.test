statement ok
INSERT INTO "lit"";λ" SELECT event_index, CASE WHEN event_index >= 6 THEN repeat('GGCCCC',3) ELSE 'CAG' END FROM "eh"";λ";

query IIII
SELECT count(*) FILTER (WHERE status='ok'),
 count(*) FILTER (WHERE reason='reference_mismatch'),
 count(*) FILTER (WHERE status='summary_only'),
 count(*) FILTER (WHERE reason='alt_index')
FROM query(duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ'));
----
3	1	3	1

query III
SELECT reference_components.count, alternate_components.count, sequence_exact
FROM query(duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ'))
WHERE event_index=6;
----
3	2	1

query II
SELECT contains(duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ'), '"eh"";λ"'),
 duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ') =
 duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ');
----
1	1

statement error

require duckvep

statement ok
CREATE TEMP TABLE "sv"";λ" (event_index INTEGER, "POS" BIGINT, "REF" VARCHAR, "ALT" VARCHAR[],
  "INFO_END" VARCHAR, "INFO_SVLEN" INTEGER[], "INFO_CIPOS" INTEGER[], "INFO_CIEND" INTEGER[], "INFO_SEQ" VARCHAR);

# INFO_END is VARCHAR here, as read_bcf gives it for a Type=String header, so '20.5'
# exercises the whole-number rule.
statement ok
INSERT INTO "sv"";λ" VALUES
(0, 13546123, 'G', ['<INS>'], '13546123', NULL, NULL, NULL, NULL),
(1, 13546123, 'G', ['<INS>'], '13546123', NULL, [-2, 0], [0, 2], 'ATG'),
(2, 13546123, 'G', ['GATG'], NULL, NULL, NULL, NULL, NULL),
(3, 20, 'A', ['<DEL>'], '22', NULL, [3, -3], NULL, NULL),
(4, 20, 'AC', ['<DEL>'], '22', NULL, NULL, NULL, NULL),
(5, 20, 'A', ['<DEL>'], '20.5', NULL, NULL, NULL, NULL),
(6, 20, 'A', ['<DEL>'], '19', NULL, NULL, NULL, NULL),
(7, 2147483647, 'A', ['AT'], NULL, NULL, NULL, NULL, NULL),
(8, 20, 'A', ['<DEL>'], '40', [-5], NULL, NULL, NULL),
(9, 20, 'A', ['<DEL>'], NULL, NULL, [-1], NULL, NULL);

query IIIIIII
SELECT count(*), count(*) FILTER (WHERE status='ok'),
  count(*) FILTER (WHERE status='unsupported_geometry'),
  count(*) FILTER (WHERE mode='literal_insertion' AND inserted_sequence='ATG'),
  count(*) FILTER (WHERE outer_start=13546122 AND outer_end=13546125 AND source_sequence='ATG'),
  count(*) FILTER (WHERE nominal_start=13546124 AND nominal_end=13546123),
  count(*) FILTER (WHERE status='ok' AND inserted_sequence IS NULL)
FROM query(duckvep_prepare_sv_geometry_sql('sv";λ'));
----
10	4	6	1	1	3	3

# SVLEN takes precedence over END, as VEP's get_end reads them; a one-value CIPOS is refused.
query IIII
SELECT event_index, status, nominal_start, nominal_end
FROM query(duckvep_prepare_sv_geometry_sql('sv";λ')) WHERE event_index IN (5, 8, 9) ORDER BY 1;
----
5	unsupported_geometry	21	21
8	ok	21	25
9	unsupported_geometry	21	21

# Scalar and list INFO columns, lower-case names, and no INFO columns at all read alike.
statement ok
CREATE TEMP TABLE sv_shapes AS SELECT 0 AS event_index, 20 AS pos, 'A' AS ref, '<DEL>' AS alt, -5 AS info_svlen
UNION ALL BY NAME SELECT 1 AS event_index, 20 AS pos, 'A' AS ref, '<DEL>' AS alt;

query III
SELECT event_index, status, nominal_end FROM query(duckvep_prepare_sv_geometry_sql('sv_shapes')) ORDER BY 1;
----
0	ok	25
1	unsupported_geometry	21

statement ok
CREATE TEMP TABLE sv_bare AS SELECT 0 AS event_index, 20 AS pos, 'A' AS ref, ['<DEL>'] AS alt;

query II
SELECT status, nominal_start FROM query(duckvep_prepare_sv_geometry_sql('sv_bare'));
----
unsupported_geometry	21

query II
SELECT contains(duckvep_prepare_sv_geometry_sql('sv";λ'), '"sv"";λ"'),
 duckvep_prepare_sv_geometry_sql('sv";λ') = duckvep_prepare_sv_geometry_sql('sv";λ');
----
1	1

statement error
SELECT duckvep_prepare_sv_geometry_sql('sv', {bogus: 1});
----
unknown option 'bogus'

statement ok
CREATE TEMP TABLE "eh"";λ" (event_index INTEGER, "INFO_END" INTEGER, "INFO_REF" INTEGER, "INFO_RL" INTEGER,
  "INFO_RU" VARCHAR, "FORMAT_GT" VARCHAR, "FORMAT_SO" VARCHAR, "FORMAT_REPCN" VARCHAR, "FORMAT_REPCI" VARCHAR,
  "FORMAT_CN" VARCHAR, "FORMAT_CI" VARCHAR, "REF" VARCHAR, "ALT" VARCHAR[], alt_index DOUBLE);

statement ok
CREATE TEMP TABLE "lit"";λ" (event_index INTEGER, reference_sequence VARCHAR);

statement ok
INSERT INTO "eh"";λ" VALUES
(0, 2008, 1, 3, 'CAG', '1/2', 'SPANNING/SPANNING', '2/10', '2-2/10-10', NULL, NULL, 'C', ['<STR2>', '<STR10>'], 1),
(1, 2008, 1, 3, 'CAG', '1/2', 'SPANNING/SPANNING', '2/10', '2-2/10-10', NULL, NULL, 'C', ['<STR2>', '<STR10>'], 2),
(2, 2008, 1, 1, 'CAG', '1/2', 'SPANNING/SPANNING', '2/10', '2-2/10-10', NULL, NULL, 'C', ['<STR2>', '<STR10>'], 1),
(3, 2008, 1, 3, 'CAG', '1/2', 'SPANNING/SPANNING', '2/10', '1-3/10-10', NULL, NULL, 'C', ['<STR2>', '<STR10>'], 1),
(4, 2008, 1, 3, 'CAG', '0/2', 'SPANNING/SPANNING', '2/10', '2-2/10-10', NULL, NULL, 'C', ['<STR2>', '<STR10>'], 1),
(5, 2008, 1, 3, 'CAG', '1/2', 'SPANNING/SPANNING', '2/10', '2-2/10-10', NULL, NULL, 'C', ['<STR2>', '<STR10>'], 3),
(6, 27573544, 3, 18, 'GGCCCC', '1/2', 'SPANNING/INREPEAT', NULL, NULL, '2/349', '2-2/323-376', 'C', ['<STR2>', '<STR349>'], 1),
(7, 27573544, 3, 18, 'GGCCCC', '1/2', 'SPANNING/INREPEAT', NULL, NULL, '2/349', '2-2/323-376', 'C', ['<STR2>', '<STR349>'], 2);

statement ok
INSERT INTO "lit"";λ" SELECT event_index, CASE WHEN event_index >= 6 THEN repeat('GGCCCC',3) ELSE 'CAG' END FROM "eh"";λ";

query IIII
SELECT count(*) FILTER (WHERE status='ok'),
 count(*) FILTER (WHERE reason='reference_mismatch'),
 count(*) FILTER (WHERE status='summary_only'),
 count(*) FILTER (WHERE reason='alt_index')
FROM query(duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ'));
----
3	1	3	1

query III
SELECT reference_components.count, alternate_components.count, sequence_exact
FROM query(duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ'))
WHERE event_index=6;
----
3	2	1

query II
SELECT contains(duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ'), '"eh"";λ"'),
 duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ') =
 duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ');
----
1	1

statement error
SELECT duckvep_prepare_expansionhunter_sql('eh";λ','lit";λ', {bogus: 1});
----
unknown option 'bogus'

# Duplicate reference rows never duplicate output rows: one row per input record,
# invalid/ambiguous_reference_sequence, with no arbitrary reference chosen.
statement ok
CREATE TEMP TABLE eh_dup_refs (event_index INTEGER, reference_sequence VARCHAR);

statement ok
INSERT INTO eh_dup_refs VALUES (0, 'CAG'), (0, 'CAG'), (1, 'CAG'), (2, 'CAG'), (2, 'TTT');

query IIIII
SELECT event_index, status, reason, sequence_exact, "source".reference_sequence
FROM query(duckvep_prepare_expansionhunter_sql('eh";λ', 'eh_dup_refs')) WHERE event_index <= 3
ORDER BY event_index;
----
0	invalid	ambiguous_reference_sequence	0	NULL
1	ok	exact	1	CAG
2	invalid	ambiguous_reference_sequence	0	NULL
3	incomplete	missing_field	0	NULL

query I
SELECT count(*) = (SELECT count(*) FROM "eh"";λ") FROM query(duckvep_prepare_expansionhunter_sql('eh";λ', 'eh_dup_refs'));
----
1

statement ok
CREATE TABLE features AS FROM query(duckvep_ensembl_regulation_features_sql('funcgen', 'regions'));

# Three regions; the circular one (2) arrives first under DESC order, so a
# region sort that fails to carry the circular flag would misattribute it.
statement ok
CREATE TABLE mregions AS
SELECT 0::UINTEGER AS seq_region, 40::UBIGINT AS sequence_length, 'A' AS seq_region_name, false AS circular
UNION ALL SELECT 1::UINTEGER, 40::UBIGINT, 'B', false
UNION ALL SELECT 2::UINTEGER, 40::UBIGINT, 'C', true;

statement ok
CREATE TABLE mtranscripts AS SELECT * REPLACE (2::UINTEGER AS seq_region) FROM transcripts;

statement ok
CREATE TABLE mfeatures AS SELECT * REPLACE (2::UINTEGER AS seq_region) FROM features;

# Ordered reference load.
query I
SELECT loaded FROM duckvep_model_load(
  'circ-ordered',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM mregions ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM mtranscripts ORDER BY transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM mtranscripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  interval_feature_query := 'SELECT regulation_feature_index, seq_region, feature_start, feature_end, feature_kind FROM mfeatures ORDER BY regulation_feature_index'
);
----
1

# Reversed regions, hash-shuffled transcripts, exons (rank order scrambled) and
# features must load: wrapped objects pass on the circular region wherever it
# arrives.
query I
SELECT loaded FROM duckvep_model_load(
  'circ-shuffled',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM mregions ORDER BY seq_region DESC',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM mtranscripts ORDER BY hash(transcript_index)',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM mtranscripts, LATERAL unnest(exons) AS u(exon) ORDER BY hash(transcript_index, exon.exon_cdna_start) DESC',
  interval_feature_query := 'SELECT regulation_feature_index, seq_region, feature_start, feature_end, feature_kind FROM mfeatures ORDER BY hash(regulation_feature_index) DESC'
);
----
1

query I
SELECT duckvep_model_drop('circ-ordered');
----
1

query I
SELECT duckvep_model_drop('circ-shuffled');
----
1

# Marking the circular region linear must reject the same model through the
# shuffled path, proving the flag is read per region after the region sort.
statement error
SELECT loaded FROM duckvep_model_load(
  'circ-shuffled-linear',
  'SELECT seq_region, sequence_length, seq_region_name, false AS circular FROM mregions ORDER BY seq_region DESC',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM mtranscripts ORDER BY hash(transcript_index)',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM mtranscripts, LATERAL unnest(exons) AS u(exon) ORDER BY hash(transcript_index, exon.exon_cdna_start) DESC'
);
----
transcript row has an invalid region, span, or strand

# A wrapped transcript moved onto a non-circular region is rejected.
statement error
SELECT loaded FROM duckvep_model_load(
  'circ-shuffled-wrapped-linear',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM mregions ORDER BY seq_region DESC',
  'SELECT transcript_index, CASE WHEN transcript_index = 3 THEN 1::UINTEGER ELSE seq_region END AS seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM mtranscripts ORDER BY hash(transcript_index)',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM mtranscripts, LATERAL unnest(exons) AS u(exon) ORDER BY hash(transcript_index, exon.exon_cdna_start) DESC'
);
----
transcript row has an invalid region, span, or strand

# A wrapped interval feature on a non-circular region is rejected.
statement error
SELECT loaded FROM duckvep_model_load(
  'circ-shuffled-feature-linear',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM mregions ORDER BY seq_region DESC',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM mtranscripts ORDER BY hash(transcript_index)',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM mtranscripts, LATERAL unnest(exons) AS u(exon) ORDER BY hash(transcript_index, exon.exon_cdna_start) DESC',
  interval_feature_query := 'SELECT regulation_feature_index, CASE WHEN regulation_feature_index = 0 THEN 0::UINTEGER ELSE seq_region END AS seq_region, feature_start, feature_end, feature_kind FROM mfeatures ORDER BY hash(regulation_feature_index) DESC'
);
----
interval-feature row has an invalid dense index, region, coordinate, or kind

# Exon validations that need per-transcript rank order still fire on scrambled input.
statement error
SELECT loaded FROM duckvep_model_load(
  'circ-shuffled-cdna',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM mregions ORDER BY seq_region DESC',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM mtranscripts ORDER BY hash(transcript_index)',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, CAST(exon.exon_cdna_end + CASE WHEN exon.exon_start = 38 THEN 1 ELSE 0 END AS UBIGINT) AS exon_cdna_end, exon.phase, exon.end_phase FROM mtranscripts, LATERAL unnest(exons) AS u(exon) ORDER BY hash(transcript_index, exon.exon_cdna_start) DESC'
);
----
circular exon cDNA length does not match its genomic span

statement error
SELECT loaded FROM duckvep_model_load(
  'circ-shuffled-rank',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM mregions ORDER BY seq_region DESC',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM mtranscripts ORDER BY hash(transcript_index)',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, CAST(CASE WHEN exon.exon_start = 35 THEN 9 WHEN exon.exon_start = 1 AND exon.exon_end = 8 AND transcript_stable_id = ''T_PLUS'' THEN 1 ELSE exon.exon_cdna_start END AS UBIGINT) AS exon_cdna_start, CAST(CASE WHEN exon.exon_start = 35 THEN 14 WHEN exon.exon_start = 1 AND exon.exon_end = 8 AND transcript_stable_id = ''T_PLUS'' THEN 8 ELSE exon.exon_cdna_end END AS UBIGINT) AS exon_cdna_end, exon.phase, exon.end_phase FROM mtranscripts, LATERAL unnest(exons) AS u(exon) ORDER BY hash(transcript_index, exon_cdna_start) DESC'
);
----
circular exon ranks must traverse the origin exactly once

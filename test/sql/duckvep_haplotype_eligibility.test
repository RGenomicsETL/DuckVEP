21	NULL	1	unsupported_context	noncanonical_start
22	NULL	1	unsupported_context	internal_stop
23	NULL	1	unsupported_context	noncanonical_stop
24	NULL	1	unsupported_context	curated_transcript
25	NULL	1	unsupported_context	incomplete_cds
26	NULL	1	predicted	supported_domain
30	NULL	1	predicted	supported_domain

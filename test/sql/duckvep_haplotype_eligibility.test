40	NULL	2	predicted	supported_domain

# Per-carrier consequences (slice 4): the edited sequence is shared by the carriers of a row, so its SO set and IMPACT
# are decided per carrier from the carrier's own keyed status. A row with one ineligible carrier keeps NULL row-level
# haplotype_consequences/haplotype_impact but does not hide the eligible carriers' set. The path of event 1 alone
# (a missense SNV) is shared by samples 2 and 3 (eligible), 4 (unphased), 5 (cross-PS) and the haploid sample 17,
# whose single lane is predicted like the diploid lanes that carry the same edit (coding-v2).

query IITTTTT
SELECT c.sample_index,c.haplotype_lane,c.prediction_status,c.prediction_reason,
 array_to_string(c.haplotype_consequences,','),c.haplotype_impact,
 CASE WHEN haplotype_consequences IS NULL THEN 'row NULL' ELSE array_to_string(haplotype_consequences,',') END
FROM (SELECT haplotype_consequences,unnest(carrier_predictions) c FROM duckvep_haplotypes(
 'SELECT * FROM hap_elig_calls WHERE sample_index IN (2,3,17,4,5)','hap_elig')) ORDER BY 1,2;
----
2	1	predicted	supported_domain	missense_variant	MODERATE	row NULL
2	2	predicted	supported_domain	missense_variant	MODERATE	missense_variant
3	1	predicted	supported_domain	missense_variant	MODERATE	row NULL
3	2	incomplete_input	missing_call	NULL	NULL	row NULL
4	1	incomplete_input	unphased_heterozygous	NULL	NULL	row NULL
4	2	incomplete_input	unphased_heterozygous	NULL	NULL	row NULL
5	1	incomplete_input	unresolved_cross_ps_phase	NULL	NULL	row NULL
5	1	incomplete_input	unresolved_cross_ps_phase	NULL	NULL	row NULL
17	1	predicted	supported_domain	missense_variant	MODERATE	row NULL

# A phased triploid call (ploidy 3) is predicted lane by lane, identically to the diploid carrier of the same path;
# with every carrier predicted the row carries the set too. One unphased slot leaves the call incomplete.

query IITTTT
SELECT c.sample_index,c.haplotype_lane,c.prediction_status,c.prediction_reason,
 array_to_string(c.haplotype_consequences,','),CASE WHEN haplotype_consequences IS NULL THEN 'row NULL' ELSE 'row set' END
FROM (SELECT haplotype_consequences,unnest(carrier_predictions) c FROM duckvep_haplotypes(
 'SELECT * FROM hap_elig_calls WHERE sample_index=2 AND event_index=1 UNION ALL SELECT 1,0,103,''G'',''A'',1,0,50,[1,0,0]::INTEGER[],[false,true,true],NULL::BIGINT',
 'hap_elig')) ORDER BY 1,2;
----
2	1	predicted	supported_domain	missense_variant	row set
50	1	predicted	supported_domain	missense_variant	row set

query IITT
SELECT c.sample_index,c.haplotype_lane,c.prediction_status,c.prediction_reason
FROM (SELECT unnest(carrier_predictions) c FROM duckvep_haplotypes(
 'SELECT 1::BIGINT event_index,0 seq_region,103::BIGINT AS position,''G'' reference,''A'' alternate,1 alt_index,0 transcript_index,51 sample_index,[1,0,0]::INTEGER[] alleles,[false,true,false] phase_before,NULL::BIGINT phase_set',
 'hap_elig')) ORDER BY 1,2;
----
51	1	incomplete_input	unphased_heterozygous
51	3	incomplete_input	unphased_heterozygous

# Metamorphic check of the extended domain: a lane's protein, consequences, impact and NMD depend on its edits only.
# The haploid lane (17) and every lane of a phased tetraploid call (60) equal the diploid lanes with the same edits
# (sample 2: event 1 on lane 1, event 2 on lane 2; sample 1: both in cis). Reference-only lanes have no row.
query ITTTTI
WITH rows AS (SELECT h.protein,c.sample_index,c.haplotype_lane lane,array_to_string(c.haplotype_consequences,',') so,
  c.haplotype_impact impact,c.nmd_prediction nmd,c.prediction_status status
 FROM (SELECT *,unnest(carrier_predictions) c FROM duckvep_haplotypes(
  'SELECT * FROM hap_elig_calls WHERE sample_index IN (1,2,17)
   UNION ALL SELECT event_index,seq_region,position,reference,alternate,alt_index,transcript_index,60,
    CASE event_index WHEN 1 THEN [1,0,1,0] ELSE [0,1,1,0] END::INTEGER[],[false,true,true,true],NULL::BIGINT
    FROM hap_elig_events WHERE event_index IN (1,2)','hap_elig')) h)
SELECT protein,min(so),min(impact),min(nmd),string_agg(sample_index||':'||lane,',' ORDER BY sample_index,lane),
 count(DISTINCT (so,impact,nmd,status))
FROM rows WHERE status='predicted' GROUP BY protein ORDER BY protein;
----
MIAEG*	missense_variant	MODERATE	not_applicable	1:1,60:3	1
MTAEG*	missense_variant	MODERATE	not_applicable	2:1,17:1,60:1	1
MVAEG*	missense_variant	MODERATE	not_applicable	2:2,60:2	1

# Genetic codes other than the standard one (coding-v2). Transcript 6 carries the vertebrate mitochondrial code
# (NCBI table 2: TGA is Trp, AGA and AGG are stops, ATA is Met and a start); transcript 7 is the same CDS
# (ATG GCT GCT GAA GGT TAA) under the standard code. The same four edits, read under each code:
#   GAA>TGA  table 2: Glu>Trp, missense                 standard: stop_gained
#   GAA>AGA  table 2: stop_gained                       standard: Glu>Arg, missense
#   ATG>ATA  table 2: ATA still starts, Met kept        standard: start_lost
#   TAA>AGA  table 2: still a stop, stop_retained       standard: stop_lost
query ITTTTT
SELECT c.sample_index,h.transcript_index::VARCHAR,c.prediction_status,array_to_string(c.haplotype_consequences,','),
 c.haplotype_impact,h.protein
FROM (SELECT *,unnest(carrier_predictions) c FROM duckvep_haplotypes(
 'SELECT e::BIGINT event_index,t seq_region,p::BIGINT AS position,r reference,a alternate,1 alt_index,t transcript_index,
   s sample_index,[1,0]::INTEGER[] alleles,[false,true] phase_before,NULL::BIGINT phase_set
  FROM (VALUES (201,6,109,''GA'',''TG'',61),(202,6,109,''GA'',''AG'',62),(203,6,102,''G'',''A'',63),(204,6,115,''TA'',''AG'',64),
               (211,7,109,''GA'',''TG'',71),(212,7,109,''GA'',''AG'',72),(213,7,102,''G'',''A'',73),(214,7,115,''TA'',''AG'',74))
   v(e,t,p,r,a,s)','hap_elig')) h ORDER BY 1;
----
61	6	predicted	missense_variant	MODERATE	MAAWG*
62	6	predicted	stop_gained	HIGH	MAA*
63	6	predicted	synonymous_variant	LOW	MAAEG*
64	6	predicted	stop_retained_variant	LOW	MAAEG*
71	7	predicted	stop_gained	HIGH	MAA*
72	7	predicted	missense_variant	MODERATE	MAARG*
73	7	predicted	start_lost	HIGH	IAAEG*
74	7	predicted	stop_lost	HIGH	MAAEGR

# carrier_predictions is parallel to carriers, and the policy version is constant.

query IIIT
SELECT count(*),count(*) FILTER (WHERE len(carriers)<>len(carrier_predictions) OR
 list_transform(carriers,lambda c: (c.sample_index,c.phase_set,c.haplotype_lane)) IS DISTINCT FROM
 list_transform(carrier_predictions,lambda c: (c.sample_index,c.phase_set,c.haplotype_lane))),
 count(DISTINCT prediction_policy),min(prediction_policy)
FROM duckvep_haplotypes('SELECT * FROM hap_elig_calls','hap_elig')
----
27	0	1	duckvep-coding-v2

# The row summary is eligible_classifier_pending or predicted only when every carrier is eligible or predicted;
# otherwise it is the first ineligible carrier's keyed result.

query II
SELECT count(*) FILTER (WHERE prediction_status IN ('eligible_classifier_pending','predicted') AND
 list_bool_or(list_transform(carrier_predictions,lambda c: c.prediction_status NOT IN ('eligible_classifier_pending','predicted')))),
 count(*) FILTER (WHERE prediction_status NOT IN ('eligible_classifier_pending','predicted') AND
 NOT list_bool_or(list_transform(carrier_predictions,lambda c: c.prediction_status NOT IN ('eligible_classifier_pending','predicted'))))
FROM duckvep_haplotypes('SELECT * FROM hap_elig_calls','hap_elig')
----
0	0

# Row-level status vocabulary, each with a stable reason, and NULL/known sequence status alongside it.
# Existing columns keep their meaning: sequence_status and projection_status are unchanged.

query TTTI
SELECT prediction_status,prediction_reason,sequence_status,count(*)
FROM duckvep_haplotypes('SELECT * FROM hap_elig_calls WHERE sample_index NOT IN (2,3,5,6,17)','hap_elig')
GROUP BY ALL ORDER BY ALL
----
edit_conflict	contradictory_edits	edit_conflict	1
incomplete_input	unphased_heterozygous	incomplete_input	1
predicted	supported_domain	ok	8
unsupported_context	curated_transcript	ok	1
unsupported_context	incomplete_cds	ok	1
unsupported_context	internal_stop	ok	1
unsupported_context	invalid_allele	unavailable_projection	1
unsupported_context	noncanonical_start	ok	1
unsupported_context	noncanonical_stop	ok	1
unsupported_context	outside_cds	unavailable_projection	2
unsupported_context	reference_mismatch	unavailable_projection	1
unsupported_overlap	ambiguous_same_gap_insertions	edit_conflict	1
unsupported_overlap	duplicate_edits	edit_conflict	1
unsupported_overlap	overlapping_edits	edit_conflict	1

# Contributor conservation: single-carrier leaves, keyed by their carrier. Every source keeps its ALT ordinal
# and role. Omitted, unapplied (conflicting) and post-stop sources are retained, not dropped.

query IITTT
SELECT carriers[1].sample_index AS sample,carriers[1].haplotype_lane AS lane,carriers[1].phase_set AS ps,prediction_status,
 string_agg(x.event_index||'/'||x.alt_index||':'||x.role,' ' ORDER BY x.event_index) AS provenance
FROM (SELECT *,unnest(contributor_provenance) x FROM duckvep_haplotypes(
 'SELECT * FROM hap_elig_calls WHERE sample_index NOT IN (2,3,5,6,17)','hap_elig') WHERE len(carriers)=1)
GROUP BY ALL ORDER BY ALL
----
1	1	NULL	predicted	1/1:applied 2/1:applied
7	1	NULL	unsupported_overlap	1/1:unapplied 5/1:unapplied
8	1	NULL	edit_conflict	1/1:unapplied 6/1:unapplied
9	1	NULL	unsupported_overlap	71/1:unapplied 72/1:unapplied
10	1	NULL	unsupported_overlap	1/1:unapplied 8/1:unapplied
11	1	NULL	unsupported_context	9/1:omitted
12	1	NULL	unsupported_context	3/1:unapplied 11/1:omitted
13	1	NULL	unsupported_context	12/1:omitted
14	1	NULL	predicted	13/1:applied
15	1	NULL	predicted	14/1:applied
16	1	NULL	predicted	3/1:post_stop 10/1:applied
18	1	NULL	unsupported_context	15/1:omitted
21	1	NULL	unsupported_context	101/1:applied
22	1	NULL	unsupported_context	102/1:applied
23	1	NULL	unsupported_context	103/1:applied
24	1	NULL	unsupported_context	104/1:applied
25	1	NULL	unsupported_context	105/1:applied
26	1	NULL	predicted	106/1:applied
30	1	NULL	predicted	16/1:applied
40	1	NULL	predicted	20/2:applied
40	2	NULL	predicted	21/1:applied

# Original operands, evidence and identity match the existing contributors list for every row, and
# every normalized edit belongs to a listed contributor.

query IIIII
SELECT count(*),count(*) FILTER (WHERE
 list_sort(list_transform(contributors,lambda c: (c.event_index,c.seq_region,c.position,c.reference,c.alternate,
  c.evidence_flags,c.projection_status))) IS DISTINCT FROM
 list_sort(list_transform(contributor_provenance,lambda c: (c.event_index,c.seq_region,c.position,c.reference,
  c.alternate,c.evidence_flags,c.projection_status)))),
 count(*) FILTER (WHERE len(contributors)<>len(contributor_provenance)),
 count(*) FILTER (WHERE list_bool_or(list_transform(normalized_edits,lambda e:
  NOT list_contains(list_transform(contributor_provenance,lambda c: c.event_index),e.event_index)))),
 count(*) FILTER (WHERE len(normalized_edits)<>edit_count)
FROM duckvep_haplotypes('SELECT * FROM hap_elig_calls','hap_elig')
----
27	0	0	0	0

# Normalized edits: ascending CDS order with their source event and block. Failed leaves keep them too,
# without a block: sample 8 conflicts, sample 7 overlaps, sample 16 has an MNV plus a post-stop SNV.

query IIT
SELECT carriers[1].sample_index AS sample,carriers[1].haplotype_lane AS lane,
 string_agg(e.edit_index||':'||e.event_index||':'||coalesce(e.block_index::VARCHAR,'-')||':'||e.cds_start||':'||
  e.reference||'>'||e.alternate||'/'||e.variant_strand,' ' ORDER BY e.edit_index) AS edits
FROM (SELECT *,unnest(normalized_edits) e FROM duckvep_haplotypes(
 'SELECT * FROM hap_elig_calls WHERE sample_index IN (1,7,8,9,10,12,16,30,40)','hap_elig')
 WHERE len(carriers)=1) GROUP BY ALL ORDER BY ALL
----
1	1	0:1:0:4:G>A/1 1:2:0:5:C>T/1
7	1	0:5:-:4:GCT>/1 1:1:-:4:G>A/1
8	1	0:6:-:4:G>T/1 1:1:-:4:G>A/1
9	1	0:72:-:7:>CCC/1 1:71:-:7:>AAA/1
10	1	0:8:-:4:G>A/1 1:1:-:4:G>A/1
12	1	0:3:-:13:G>C/1
16	1	0:10:0:4:GCT>TAG/1 1:3:1:13:G>C/1
30	1	0:16:0:4:GC>AT/1
40	1	0:20:0:7:G>T/1
40	2	0:21:0:7:G>A/1

# Sequence deduplication cannot erase contributors: the cis SNV pair of sample 1 and the MNV of sample 30
# rebuild the same CDS in different leaves, and each keeps its own sources and edits.

query TIIT
SELECT cds,carriers[1].sample_index,len(contributor_provenance),
 string_agg(DISTINCT x.event_index::VARCHAR,',' ORDER BY x.event_index::VARCHAR) AS sources
FROM (SELECT *,unnest(contributor_provenance) x FROM duckvep_haplotypes(
 'SELECT * FROM hap_elig_calls WHERE sample_index IN (1,30)','hap_elig')) GROUP BY ALL ORDER BY ALL
----
ATGATTGCTGAAGGTTAA	1	2	1,2
ATGATTGCTGAAGGTTAA	30	1	16

# Reference lanes: the reference lane of a heterozygous call is not a leaf in strict decoded input, and
# samples with the same edit path share one leaf whose contributors are listed once.

query II
SELECT count(*) FILTER (WHERE c.sample_index=1 AND c.haplotype_lane=1),
 count(*) FILTER (WHERE c.sample_index=1 AND c.haplotype_lane=2)
FROM (SELECT unnest(carriers) c FROM duckvep_haplotypes('SELECT * FROM hap_elig_calls','hap_elig'))
----
1	0

query III
SELECT count(*),sum(len(contributor_provenance)),max(len(carriers))
FROM duckvep_haplotypes('SELECT * FROM hap_elig_calls WHERE sample_index IN (1,10,40) AND event_index=1
 UNION ALL SELECT * REPLACE (sample_index+100 AS sample_index) FROM hap_elig_calls WHERE sample_index=1 AND event_index=1','hap_elig')
----
1	1	3

# Source-record replay (vep116_compat) is a compatibility interpretation, outside the strict v1 domain:
# reference-only lanes (the 0|0 record, whose nonmutating REF contributor is not emitted) and shadowed/duplicate
# sources keep provenance but get non_strict_phase_policy.

statement ok
CREATE TABLE hap_elig_raw AS SELECT * FROM (VALUES
 (1::UBIGINT,0::UINTEGER,103::UBIGINT,'G',['A'],0::UINTEGER,0::UINTEGER,'1|0'),
 (2,0,104,'C',['T'],0,0,'1|0'),
 (3,0,123,'G',['C'],0,1,'0|1'),
 (4,0,103,'G',['A'],0,1,'0|0'),
 (5,0,103,'G',['A'],0,2,'1|0'),
 (6,0,103,'G',['A'],0,2,'1|0')) t(event_index,seq_region,position,reference,alternates,transcript_index,sample_index,gt)

query TTIIIII
SELECT prediction_status,prediction_reason,count(*),sum(len(contributors)),sum(len(contributor_provenance)),
 count(*) FILTER (WHERE list_bool_or(list_transform(carrier_predictions,lambda c: c.prediction_status<>prediction_status))),
 count(*) FILTER (WHERE edit_count=0 AND len(contributor_provenance)=0)
FROM duckvep_haplotypes('SELECT * FROM hap_elig_raw','hap_elig',input_mode:='source_records',
 phase_policy:='vep116_compat') GROUP BY ALL ORDER BY ALL
----
unsupported_context	non_strict_phase_policy	6	5	5	0	3

query IITTI
SELECT x.event_index,x.alt_index,x.role,x.projection_status,x.evidence_flags
FROM (SELECT unnest(contributor_provenance) x FROM duckvep_haplotypes('SELECT * FROM hap_elig_raw',
 'hap_elig',input_mode:='source_records',phase_policy:='vep116_compat')) ORDER BY ALL
----
1	1	shadowed	shadowed_duplicate	1
2	1	applied	ok	1
3	1	applied	ok	1
5	1	applied	ok	1
6	1	shadowed	shadowed_duplicate	1

statement ok
DROP TABLE hap_elig_raw

# The vep116_compat policy on decoded calls is likewise outside the strict domain, but missing calls stay
# incomplete_input.

query IITT
SELECT c.sample_index,c.haplotype_lane,c.prediction_status,c.prediction_reason
FROM (SELECT unnest(carrier_predictions) c FROM duckvep_haplotypes(
 'SELECT * FROM hap_elig_calls WHERE sample_index IN (1,2,3,4)','hap_elig',phase_policy:='vep116_compat'))
ORDER BY 1,2,3
----
1	1	unsupported_context	non_strict_phase_policy
2	1	unsupported_context	non_strict_phase_policy
2	2	unsupported_context	non_strict_phase_policy
3	1	incomplete_input	missing_call
3	2	incomplete_input	missing_call
4	2	unsupported_context	non_strict_phase_policy

statement ok
DROP TABLE hap_elig_calls

statement ok

CREATE TABLE hap_elig_calls AS SELECT e.event_index,e.seq_region,e.position,e.reference,e.alternate,
 e.alt_index,e.transcript_index,g.sample_index,g.alleles,g.phase_before,g.phase_set
 FROM hap_elig_events e JOIN hap_elig_gt g USING(event_index)

# Keyed eligibility per sample/phase/lane. Samples: 1 cis pair, 2 trans control, 3 missing allele,
# 4 unphased heterozygous, 5 heterozygous in PS 10 and PS 20 (cross-PS), 6 hom-alt plus one het PS, 7 SNV inside a
# deletion, 8 contradictory SNVs, 9 two insertions in one gap, 10 duplicated record, 11 REF mismatch,
# 12 intronic plus exonic, 13 deletion across an exon boundary, 14 a 51-base in-frame and 15 a 50-base frameshifting insertion,
# 16 stop-creating MNV with a later SNV, 17 haploid call, 18 N allele, 30 MNV, 40 multiallelic ALT 2,
# 21-26 transcripts 1-6 outside the CDS domain.

query ITITT
SELECT c.sample_index,c.phase_set,c.haplotype_lane,c.prediction_status,c.prediction_reason
FROM (SELECT unnest(carrier_predictions) c FROM duckvep_haplotypes(
 'SELECT * FROM hap_elig_calls','hap_elig')) ORDER BY 1,2 NULLS FIRST,3
----

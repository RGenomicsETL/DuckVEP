2	NULL	1	predicted	supported_domain
2	NULL	2	predicted	supported_domain
3	NULL	1	predicted	supported_domain
3	NULL	2	incomplete_input	missing_call
4	NULL	1	incomplete_input	unphased_heterozygous
4	NULL	2	incomplete_input	unphased_heterozygous
5	10	1	incomplete_input	unresolved_cross_ps_phase
5	20	1	incomplete_input	unresolved_cross_ps_phase
6	10	1	predicted	supported_domain
6	10	2	predicted	supported_domain
7	NULL	1	unsupported_overlap	overlapping_edits

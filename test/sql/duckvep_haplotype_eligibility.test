require duckvep

# Coding-v1 eligibility and provenance (slice 2 of #2, contract design/duckvep_haplotype_contract.md).
# prediction_status/prediction_reason only say whether a leaf is inside the supported domain; no SO, IMPACT or
# NMD is predicted yet. The keyed result per sample/phase/lane is carrier_predictions. The row summary is
# eligible_classifier_pending only when every carrier is.
# Fixture transcript 0 is + strand with two coding exons: exon 1 = 100-108 (ATGGCTGCT), exon 2 = 120-128
# (GAAGGTTAA); codons are Met Ala Ala Glu Gly Stop. Transcripts 1-6 are single-exon variants of it that each
# break one v1 CDS requirement.

query T
SELECT loaded FROM duckvep_model_load('hap_elig',
 'SELECT i::UINTEGER seq_region FROM range(8) t(i)',
 'SELECT i::UINTEGER transcript_index,i::UINTEGER seq_region,100::UBIGINT transcript_start,
  CASE WHEN i=0 THEN 128 ELSE 117 END::UBIGINT transcript_end,1::TINYINT strand,i::UINTEGER gene_index,
  CASE i WHEN 4 THEN 259 WHEN 5 THEN 19 ELSE 3 END::UBIGINT transcript_flags,100::UBIGINT cds_start,
  CASE WHEN i=0 THEN 128 ELSE 117 END::UBIGINT cds_end,
  CASE i WHEN 1 THEN ''CTGGCTGCTGAAGGTTAA'' WHEN 2 THEN ''ATGGCTTAAGAAGGTTAA''
   WHEN 3 THEN ''ATGGCTGCTGAAGGTGGT'' ELSE ''ATGGCTGCTGAAGGTTAA'' END::BLOB cds_sequence,
  CASE WHEN i=6 THEN 2 ELSE 1 END::UTINYINT codon_table,''''::BLOB pre_cds_sequence,
  ''''::BLOB post_cds_sequence FROM range(8) t(i)',
 'SELECT * FROM (SELECT i::UINTEGER transcript_index,100::UBIGINT exon_start,
  (CASE WHEN i=0 THEN 108 ELSE 117 END)::UBIGINT exon_end,1::UBIGINT exon_cdna_start,
  (CASE WHEN i=0 THEN 9 ELSE 18 END)::UBIGINT exon_cdna_end,0::TINYINT phase,0::TINYINT end_phase
  FROM range(8) t(i) UNION ALL SELECT 0::UINTEGER,120::UBIGINT,128::UBIGINT,10::UBIGINT,18::UBIGINT,
  0::TINYINT,0::TINYINT) ORDER BY transcript_index,exon_start')
----
true

statement ok
CREATE TABLE hap_elig_events(event_index BIGINT, seq_region INT, position BIGINT, reference VARCHAR,
 alternate VARCHAR, alt_index INT, transcript_index INT)


query T
SELECT duckvep_model_drop('hap_elig')
----
true

# DuckDB vector boundaries: 2,100 transcripts with two SNVs each give 4,200 input rows and 2,800 output rows,
# so the input, the output chunks, and every provenance/edit/carrier list child cross 2,048. Transcript i mod 3:
# 0 cis pair (eligible, one leaf), 1 unphased heterozygous pair (incomplete_input, one leaf with 2 carriers),
# 2 trans pair (eligible, two leaves).

query T
SELECT loaded FROM duckvep_model_load('hap_elig_wide',
 'SELECT 0::UINTEGER seq_region',
 'SELECT i::UINTEGER transcript_index,0::UINTEGER seq_region,(100+30*i)::UBIGINT transcript_start,
  (117+30*i)::UBIGINT transcript_end,1::TINYINT strand,i::UINTEGER gene_index,3::UBIGINT transcript_flags,
  (100+30*i)::UBIGINT cds_start,(117+30*i)::UBIGINT cds_end,''ATGGCTGCTGAAGGTTAA''::BLOB cds_sequence,
  1::UTINYINT codon_table,''''::BLOB pre_cds_sequence,''''::BLOB post_cds_sequence FROM range(2100) t(i)',
 'SELECT i::UINTEGER transcript_index,(100+30*i)::UBIGINT exon_start,(117+30*i)::UBIGINT exon_end,
  1::UBIGINT exon_cdna_start,18::UBIGINT exon_cdna_end,0::TINYINT phase,0::TINYINT end_phase
  FROM range(2100) t(i)')
----
true

statement ok
CREATE TABLE hap_elig_wide_calls AS SELECT 2*i+j+1 AS event_index,0 AS seq_region,
 103+30*i+j AS position,CASE WHEN j=0 THEN 'G' ELSE 'C' END AS reference,
 CASE WHEN j=0 THEN 'A' ELSE 'T' END AS alternate,1 AS alt_index,i AS transcript_index,0 AS sample_index,
 CASE WHEN i%3=1 THEN [0,1] WHEN i%3=2 AND j=1 THEN [0,1] ELSE [1,0] END AS alleles,
 CASE WHEN i%3=1 THEN [false,false] ELSE [false,true] END AS phase_before,NULL::BIGINT AS phase_set
 FROM range(2100) t(i) CROSS JOIN range(2) e(j)

query ITTIIIIIIIII
SELECT transcript_index%3 AS kind,prediction_status,prediction_reason,count(*),sum(len(carriers)),
 sum(len(contributor_provenance)),sum(len(normalized_edits)),sum(len(carrier_predictions)),
 count(*) FILTER (WHERE list_sort(list_transform(contributor_provenance,lambda c: c.event_index))<>
  list_sort(list_transform(contributors,lambda c: c.event_index))),
 count(*) FILTER (WHERE list_bool_or(list_transform(contributor_provenance,lambda c:
  c.event_index NOT IN (2*transcript_index+1,2*transcript_index+2)))),
 count(*) FILTER (WHERE list_bool_or(list_transform(normalized_edits,lambda e:
  e.event_index NOT IN (2*transcript_index+1,2*transcript_index+2) OR e.cds_start NOT IN (4,5)))),
 count(*) FILTER (WHERE list_bool_or(list_transform(carrier_predictions,lambda c:
  c.prediction_status<>prediction_status)))
FROM duckvep_haplotypes('SELECT * FROM hap_elig_wide_calls','hap_elig_wide')
GROUP BY ALL ORDER BY ALL
----
0	predicted	supported_domain	700	700	1400	1400	700	0	0	0	0
1	incomplete_input	unphased_heterozygous	700	1400	1400	0	1400	0	0	0	0
2	predicted	supported_domain	1400	1400	1400	1400	1400	0	0	0	0

query IIII
SELECT count(*),count(DISTINCT transcript_index),min(transcript_index),max(transcript_index)
FROM duckvep_haplotypes('SELECT * FROM hap_elig_wide_calls','hap_elig_wide')
----
2800	2100	0	2099

statement ok

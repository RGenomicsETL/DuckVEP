# Failures are explicit, never truncated: malformed identities and exhausted budgets error out.

statement ok
CREATE TABLE hap_elig_bad AS SELECT 1 event_index,0 seq_region,103 AS position,'G' AS reference,'A' AS alternate,
 1 alt_index,0 transcript_index,0 sample_index,[1,0] alleles,[false,true] phase_before,NULL::BIGINT phase_set

statement error
SELECT * FROM duckvep_haplotypes('SELECT * REPLACE (NULL AS alt_index) FROM hap_elig_bad','hap_elig')
----
required input column 6 is NULL

statement error
SELECT * FROM duckvep_haplotypes('SELECT * REPLACE (0 AS alt_index) FROM hap_elig_bad','hap_elig')
----
invalid input or candidate

statement error
SELECT * FROM duckvep_haplotypes('SELECT * FROM hap_elig_bad UNION ALL SELECT * REPLACE (104 AS position) FROM hap_elig_bad','hap_elig')
----
inconsistent event identity

statement ok
DROP TABLE hap_elig_bad

statement ok
CREATE TABLE hap_elig_budget AS SELECT * FROM (VALUES
 (1,0,103,'G','A',1,0,0,[1,0],[false,true],NULL::BIGINT),
 (2,0,104,'C','T',1,0,0,[1,0],[false,true],NULL::BIGINT)) t(event_index,seq_region,position,reference,alternate,
 alt_index,transcript_index,sample_index,alleles,phase_before,phase_set)

query I
SELECT count(*) FROM duckvep_haplotypes('SELECT * FROM hap_elig_budget','hap_elig',max_leaf_events:=2)
----
1


# name: test/sql/duckvep_peptide_edit.test
# description: Original alleles on transcripts whose reference peptide carries a translation SeqEdit
# group: [duckvep]

require duckvep

# Executable VEP 116 witnesses from the seeded peptide-edit campaign
# (test/duckvep/conformance/peptide_edit_differential.R, seed 7). Cache-mode VEP
# applies translation SeqEdits to the reference TranscriptVariationAllele
# peptide only. A `_stop_codon_rt` edit to X therefore gives every SNV in that
# codon an X-bearing reference allele: coding_sequence_variant coexists with
# missense_variant, or with stop_gained when the new codon is another stop,
# while HGVSp still spells the raw stop as Ter. The selenocysteine model pins
# _get_fs_peptides() "deletion of stop" rows: start is the unclipped
# translation_start, end and the reference peptide stay as _clip_alleles left
# them, so the range reads Thr8_Ter9.
statement ok
CREATE TABLE edit_transcripts AS SELECT * FROM (VALUES
  (0::UINTEGER, 'readthrough_x', 'ATGCCCATCCGAAACTTCTGATAG', 'X', '_stop_codon_rt'),
  (1::UINTEGER, 'selenocysteine', 'ATGAGGATCCGTTGCATTTGAACTTAA', 'U', '_selenocysteine')
) t(transcript_index, seq_region_name, cds, edit_amino, edit_code);

query I
SELECT loaded FROM duckvep_model_load('peptide-edit',
  'SELECT transcript_index seq_region, (length(cds) + 20)::UBIGINT sequence_length,
   seq_region_name FROM edit_transcripts ORDER BY seq_region',
  'SELECT transcript_index, transcript_index seq_region, 11::UBIGINT transcript_start,
   (10 + length(cds))::UBIGINT transcript_end, 1::TINYINT strand, transcript_index gene_index,
   3::UBIGINT transcript_flags, 11::UBIGINT cds_start, (10 + length(cds))::UBIGINT cds_end,
   cds::BLOB cds_sequence, 1::UTINYINT codon_table, ''''::BLOB pre_cds_sequence,
   ''''::BLOB post_cds_sequence FROM edit_transcripts ORDER BY transcript_index',
  'SELECT transcript_index, 11::UBIGINT exon_start, (10 + length(cds))::UBIGINT exon_end,
   1::UBIGINT exon_cdna_start, length(cds)::UBIGINT exon_cdna_end, 0::TINYINT phase,
   0::TINYINT end_phase FROM edit_transcripts ORDER BY transcript_index',
  reference_fasta := '__WORKING_DIRECTORY__/test/data/duckvep/peptide_edit_witness.fa',
  peptide_edit_query := 'SELECT transcript_index, 7::UINTEGER protein_position,
   edit_amino alternate_amino_acid, edit_code FROM edit_transcripts ORDER BY transcript_index');
----
1

statement ok
CREATE TABLE edit_events AS SELECT event_index::UBIGINT event_index, seq_region::UINTEGER seq_region,
  position::UBIGINT AS position, reference, alternate, NULL::UBIGINT end_position,
  NULL::VARCHAR structural_type, NULL::VARCHAR copy_change, NULL::UINTEGER mate_seq_region,
  NULL::UBIGINT mate_position FROM (VALUES
  (1, 0, 29, 'T', 'A'), (2, 0, 29, 'T', 'C'), (3, 0, 29, 'T', 'G'),
  (4, 0, 30, 'G', 'A'), (5, 0, 30, 'G', 'C'), (6, 0, 30, 'G', 'T'),
  (7, 0, 31, 'A', 'C'), (8, 0, 31, 'A', 'G'), (9, 0, 31, 'A', 'T'),
  (10, 1, 30, 'GAACT', 'G'), (11, 1, 31, 'AACTTA', 'A'), (12, 1, 31, 'AACTT', 'A')
) s(event_index, seq_region, position, reference, alternate);

query ITTTTT
SELECT event_index,
  (SELECT string_agg(t.consequence, '&' ORDER BY t.consequence)
   FROM duckvep_so_terms() t WHERE (a.consequence_mask & t.consequence_mask) <> 0),
  coalesce(reference_amino_acid, '-') || '/' || coalesce(alternate_amino_acid, '-'),
  protein_hgvs, protein_hgvs_status, duckvep_status
FROM query(duckvep_annotate_sql('edit_events', 'peptide-edit', struct_pack(
  hgvs := true, rich := true, upstream_distance := 0, downstream_distance := 0))) a
ORDER BY event_index;
----
1	coding_sequence_variant&missense_variant	X/R	p.Ter7Arg	supported	supported
2	coding_sequence_variant&missense_variant	X/R	p.Ter7Arg	supported	supported
3	coding_sequence_variant&missense_variant	X/G	p.Ter7Gly	supported	supported
4	coding_sequence_variant&stop_gained	X/*	p.Ter7=	supported	supported
5	coding_sequence_variant&missense_variant	X/S	p.Ter7Ser	supported	supported
6	coding_sequence_variant&missense_variant	X/L	p.Ter7Leu	supported	supported
7	coding_sequence_variant&missense_variant	X/C	p.Ter7Cys	supported	supported
8	coding_sequence_variant&missense_variant	X/W	p.Ter7Trp	supported	supported
9	coding_sequence_variant&missense_variant	X/C	p.Ter7Cys	supported	supported
10	frameshift_variant	-/-	p.Thr8_Ter9del	supported	supported
11	frameshift_variant&stop_lost	-/-	p.Thr8_Ter9delextTer?	supported	supported
12	frameshift_variant&stop_lost	-/-	p.Thr8_Ter9delextTer?	supported	supported

query I
SELECT duckvep_model_drop('peptide-edit');
----
1

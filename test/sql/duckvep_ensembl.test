# name: test/sql/duckvep_ensembl.test
# description: Ensembl core plus tiled FASTA to validated resident DuckVEP model
# group: [duckvep]

require duckvep

statement error
SELECT duckvep_ensembl_regions_sql('core', 'reference', 'GRCh37', species_id := 2);
----
<REGEX>:(options must be a STRUCT|duckvep_ensembl_regions_sql)

statement error
SELECT duckvep_ensembl_regions_sql('core', 'reference', 'GRCh37', {specis_id: 2});
----
unknown option 'specis_id'

statement error
SELECT duckvep_ensembl_transcripts_sql('core', 'reference', 'GRCh37', {species_id: '2'});
----
expected INTEGER for option 'species_id'

statement error
SELECT duckvep_ensembl_regulation_features_sql('funcgen', 'regions', {bogus: 2});
----
no options are supported

query TTT
SELECT contains(duckvep_ensembl_regions_sql('a"b', 'c.d"e', 'G''RCh37'), '"a""b"."seq_region"'),
       contains(duckvep_ensembl_regions_sql('a"b', 'c.d"e', 'G''RCh37'), '"c"."d""e"'),
       duckvep_ensembl_regions_sql('a"b', 'c.d"e', 'G''RCh37') = duckvep_ensembl_regions_sql('a"b', 'c.d"e', 'G''RCh37');
----
true	true	true


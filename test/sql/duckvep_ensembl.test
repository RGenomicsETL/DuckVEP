  'duckvep_core', 'duckvep_reference_chunks', 'GRCh38'));

query IIIT
SELECT rna_cds_cdna_start, rna_cds_cdna_end, rna_codon_table,
       CAST(cdna_sequence AS VARCHAR)
FROM duckvep_rna_producer_transcripts WHERE transcript_index = 3;

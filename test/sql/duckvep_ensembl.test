query I
SELECT loaded FROM duckvep_model_load(
  'ensembl-authority',
  'SELECT seq_region, sequence_length FROM duckvep_prepared_regions ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence, cdna_sequence, rna_cds_cdna_start, rna_cds_cdna_end, rna_codon_table FROM duckvep_prepared_transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM duckvep_prepared_transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  rna_edit_query := 'SELECT * FROM duckvep_source_rna_rows',
  transcript_coverage_complete := true
);
----
1

query I
SELECT duckvep_model_save('ensembl-authority', '__TEST_DIR__/ensembl-authority.dvsnap');
----
1

query I
SELECT duckvep_model_restore('ensembl-authority-copy', '__TEST_DIR__/ensembl-authority.dvsnap');
----
1

query I
SELECT _duckvep_model_fingerprint('ensembl-authority') = _duckvep_model_fingerprint('ensembl-authority-copy');
----
1

statement ok
CREATE MACRO authority_wire_offset(data, at_byte) AS (
  SELECT CAST(sum(('0x' || substr(hex(data), (at_byte + i) * 2 - 1, 2))::UBIGINT *
             (1::UBIGINT << (i * 8))) AS BIGINT) FROM range(8) AS r(i)
);

query TTT
SELECT substr(hex(content), (authority_wire_offset(content, 1017) + 1) * 2 - 1, 24),
       substr(hex(content), (authority_wire_offset(content, 1025) + 1) * 2 - 1, 24),
       substr(hex(content), (authority_wire_offset(content, 1033) + 1) * 2 - 1, 6)
FROM read_blob('__TEST_DIR__/ensembl-authority.dvsnap');
----
010000000100000001000000	0C0000000900000009000000	020202

query I
SELECT duckvep_model_save('ensembl-authority-copy', '__TEST_DIR__/ensembl-authority-copy.dvsnap');
----
1


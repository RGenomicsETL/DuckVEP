statement ok
CREATE TABLE ev_mix AS SELECT r.event_index, g.seq_region, r.position, r.reference, r.alternate,
  NULL::UBIGINT AS end_position, NULL::VARCHAR AS structural_type, NULL::VARCHAR AS copy_change,
  NULL::UINTEGER AS mate_seq_region, NULL::UBIGINT AS mate_position
  FROM ev_mix_raw r JOIN regions_mix g ON g.seq_region_name = r.contig ORDER BY r.position, r.event_index;

statement ok
CREATE TABLE res_mix AS
SELECT a.event_index, a.duckvep_event_kind, coalesce(t.transcript_stable_id, 'none') AS object,
  a.consequence_mask, a.region_mask, a.impact_code, a.status_code, a.reason_code,
  a.cdna_position, a.cds_position, a.protein_position,
  a.reference_amino_acid_code, a.alternate_amino_acid_code, a.nmd_prediction_code,
  a.nmd_escape_reasons, a.overlap_object_code,
  a.transcript_hgvs, a.protein_hgvs, a.hgvs_shift, a.transcript_hgvs_status,
  a.transcript_hgvs_reason, a.protein_hgvs_status, a.protein_hgvs_reason
FROM query(duckvep_annotate_sql('ev_mix', 'mix', struct_pack(hgvs := true, upstream_distance := 40, downstream_distance := 40))) a
LEFT JOIN transcripts_mix t ON t.transcript_index = a.transcript_index;

statement ok
CREATE TABLE ev_mix_c AS SELECT * FROM ev_mix WHERE seq_region IN (SELECT seq_region FROM regions_mix WHERE seq_region_name = 'CM');

statement ok
CREATE TABLE res_mix_c AS
SELECT a.event_index, a.duckvep_event_kind, coalesce(t.transcript_stable_id, 'none') AS object,
  a.consequence_mask, a.region_mask, a.impact_code, a.status_code, a.reason_code,
  a.cdna_position, a.cds_position, a.protein_position,
  a.reference_amino_acid_code, a.alternate_amino_acid_code, a.nmd_prediction_code,
  a.nmd_escape_reasons, a.overlap_object_code,
  a.transcript_hgvs, a.protein_hgvs, a.hgvs_shift, a.transcript_hgvs_status,
  a.transcript_hgvs_reason, a.protein_hgvs_status, a.protein_hgvs_reason
FROM query(duckvep_annotate_sql('ev_mix_c', 'mix_c', struct_pack(hgvs := true, upstream_distance := 40, downstream_distance := 40))) a
LEFT JOIN transcripts_mix_c t ON t.transcript_index = a.transcript_index;

statement ok
CREATE TABLE ev_mix_l AS SELECT * FROM ev_mix WHERE seq_region IN (SELECT seq_region FROM regions_mix WHERE seq_region_name = 'LM');

statement ok
CREATE TABLE res_mix_l AS
SELECT a.event_index, a.duckvep_event_kind, coalesce(t.transcript_stable_id, 'none') AS object,
  a.consequence_mask, a.region_mask, a.impact_code, a.status_code, a.reason_code,
  a.cdna_position, a.cds_position, a.protein_position,
  a.reference_amino_acid_code, a.alternate_amino_acid_code, a.nmd_prediction_code,
  a.nmd_escape_reasons, a.overlap_object_code,
  a.transcript_hgvs, a.protein_hgvs, a.hgvs_shift, a.transcript_hgvs_status,
  a.transcript_hgvs_reason, a.protein_hgvs_status, a.protein_hgvs_reason
FROM query(duckvep_annotate_sql('ev_mix_l', 'mix_l', struct_pack(hgvs := true, upstream_distance := 40, downstream_distance := 40))) a
LEFT JOIN transcripts_mix_l t ON t.transcript_index = a.transcript_index;

query IIIIIIII
SELECT (SELECT count(*) FROM res_mix), (SELECT count(*) FROM res_mix_c), (SELECT count(*) FROM res_mix_l),
  (SELECT count(*) FROM (SELECT * FROM res_mix WHERE event_index < 10000000 EXCEPT SELECT * FROM res_mix_c)),
  (SELECT count(*) FROM (SELECT * FROM res_mix_c EXCEPT SELECT * FROM res_mix WHERE event_index < 10000000)),
  (SELECT count(*) FROM (SELECT * FROM res_mix WHERE event_index >= 10000000 EXCEPT SELECT * FROM res_mix_l)),
  (SELECT count(*) FROM (SELECT * FROM res_mix_l EXCEPT SELECT * FROM res_mix WHERE event_index >= 10000000)),
  (SELECT count(DISTINCT object) FROM res_mix);

CREATE TABLE core_mix.translation AS SELECT * FROM (VALUES
  (80, 70, 1, 700, 39, 700, 'P_CM', 1), (81, 71, 4, 701, 57, 701, 'P_LM', 1))
  t(translation_id, transcript_id, seq_start, start_exon_id, seq_end, end_exon_id, stable_id, version);

statement ok
CREATE TABLE ref_mix AS SELECT * FROM (VALUES
  ('CM', 0, 400, ''), ('LM', 0, 600, ''))
  t(chrom, "start", "end", seq);

statement ok
COPY (SELECT line FROM (SELECT 0 AS o, '>CM' AS line UNION ALL SELECT 1, seq FROM ref_mix WHERE chrom = 'CM'
  UNION ALL SELECT 2, '>LM' UNION ALL SELECT 3, seq FROM ref_mix WHERE chrom = 'LM') ORDER BY o)
  TO '__TEST_DIR__/circular_mixed.fa' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT * FROM (VALUES ('CM', 400, 4, 400, 401), ('LM', 600, 409, 600, 601)))
  TO '__TEST_DIR__/circular_mixed.fa.fai' (FORMAT csv, HEADER false, DELIMITER '\t', QUOTE '', ESCAPE '');

statement ok
CREATE TABLE regions_mix AS FROM query(duckvep_ensembl_regions_sql('core_mix', 'ref_mix', 'synthetic'));

statement ok
CREATE TABLE transcripts_mix AS FROM query(duckvep_ensembl_transcripts_sql('core_mix', 'ref_mix', 'synthetic'));

query I
SELECT loaded FROM duckvep_model_load(
  'mix',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions_mix WHERE true ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts_mix ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts_mix, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  reference_fasta := '__TEST_DIR__/circular_mixed.fa'
);
----
1

statement ok
CREATE TABLE transcripts_mix_c AS SELECT * REPLACE ((row_number() OVER (ORDER BY seq_region, transcript_start) - 1)::UINTEGER AS transcript_index)
  FROM transcripts_mix WHERE seq_region_name = 'CM';

query I
SELECT loaded FROM duckvep_model_load(
  'mix_c',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions_mix WHERE seq_region_name = ''CM'' ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts_mix_c ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts_mix_c, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  reference_fasta := '__TEST_DIR__/circular_mixed.fa'
);
----
1

statement ok
CREATE TABLE transcripts_mix_l AS SELECT * REPLACE ((row_number() OVER (ORDER BY seq_region, transcript_start) - 1)::UINTEGER AS transcript_index)
  FROM transcripts_mix WHERE seq_region_name = 'LM';

query I
SELECT loaded FROM duckvep_model_load(
  'mix_l',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions_mix WHERE seq_region_name = ''LM'' ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts_mix_l ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts_mix_l, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  reference_fasta := '__TEST_DIR__/circular_mixed.fa'
);

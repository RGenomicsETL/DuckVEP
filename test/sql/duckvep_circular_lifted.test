CREATE VIEW lin10.translation AS SELECT * FROM core.translation;

statement ok
CREATE VIEW lin10.transcript_attrib AS SELECT * FROM core.transcript_attrib;

statement ok
CREATE VIEW lin10.translation_attrib AS SELECT * FROM core.translation_attrib;

statement ok
CREATE TABLE lin10.seq_region_attrib AS SELECT * FROM core.seq_region_attrib WHERE false;

statement ok
CREATE TABLE lin10.transcript AS SELECT 900 AS transcript_id, 20 AS gene_id, 10 AS seq_region_id,
  10 AS seq_region_start, 20 AS seq_region_end, 1 AS seq_region_strand, 'lncRNA' AS biotype, 1 AS is_current,
  'FILLER' AS stable_id, 1 AS version;

statement ok
CREATE TABLE lin10.exon_transcript AS SELECT 900 AS exon_id, 900 AS transcript_id, 1 AS rank;

statement ok
CREATE TABLE lin10.exon AS SELECT 900 AS exon_id, 10 AS seq_region_id, 10 AS seq_region_start,
  20 AS seq_region_end, 1 AS seq_region_strand, -1 AS phase, -1 AS end_phase, 1 AS is_current, 'FILLER_E1' AS stable_id;

statement ok
CREATE VIEW linf10.feature_type AS SELECT * FROM funcgen.feature_type;

statement ok
CREATE TABLE linf10.regulatory_feature AS SELECT regulatory_feature_id, feature_type_id, seq_region_id,
  seq_region_strand, rot(seq_region_start, 1499) AS seq_region_start, rot(seq_region_end, 1499) AS seq_region_end,
  stable_id, regulatory_build_id FROM funcgen.regulatory_feature WHERE stable_id = 'M_WRAP';

statement ok
CREATE TABLE linf10.motif_feature AS SELECT motif_feature_id, binding_matrix_id, seq_region_id,
  rot(seq_region_start, 1499) AS seq_region_start, rot(seq_region_end, 1499) AS seq_region_end,
  seq_region_strand, score, stable_id FROM funcgen.motif_feature WHERE stable_id = 'M_WRAP';

statement ok
CREATE TABLE ref_lin10 AS SELECT chrom, "start", "end",
  substr(seq, 1501 + 1) || substr(seq, 1, 1501) AS seq FROM ref;

statement ok
COPY (SELECT line FROM (SELECT 0 AS o, '>' || chrom AS line FROM ref_lin10
  UNION ALL SELECT 1, seq FROM ref_lin10) ORDER BY o) TO '__TEST_DIR__/linear_10.fa'
  (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT chrom, 3000, length('>' || chrom) + 1, 3000, 3000 + 1 FROM ref_lin10)
  TO '__TEST_DIR__/linear_10.fa.fai' (FORMAT csv, HEADER false, DELIMITER '	', QUOTE '', ESCAPE '');

statement ok
CREATE TABLE regions_lin10 AS FROM query(duckvep_ensembl_regions_sql('lin10', 'ref_lin10', 'synthetic'));

statement ok
CREATE TABLE transcripts_lin10 AS FROM query(duckvep_ensembl_transcripts_sql('lin10', 'ref_lin10', 'synthetic'));

statement ok
CREATE TABLE features_lin10 AS FROM query(duckvep_ensembl_regulation_features_sql('linf10', 'regions_lin10'));

query I
SELECT loaded FROM duckvep_model_load(
  'lin_10',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions_lin10 ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts_lin10 ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts_lin10, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  interval_feature_query := 'SELECT regulation_feature_index, seq_region, feature_start, feature_end, feature_kind FROM features_lin10 ORDER BY regulation_feature_index',
  reference_fasta := '__TEST_DIR__/linear_10.fa'
);
----
1

statement ok
CREATE TABLE ev_lin10 AS SELECT e.event_index, (SELECT seq_region FROM regions_lin10) AS seq_region,
  rot(e.u_pos, 1499)::UBIGINT AS position, substr(r.seq || r.seq, rot(e.u_pos, 1499), e.ref_length) AS reference,
  e.alt AS alternate, NULL::UBIGINT AS end_position, NULL::VARCHAR AS structural_type,
  NULL::VARCHAR AS copy_change, NULL::UINTEGER AS mate_seq_region, NULL::UBIGINT AS mate_position
  FROM ev0 e, ref_lin10 r WHERE rot(e.u_pos, 1499) + e.ref_length - 1 <= 3000;

statement ok
CREATE TABLE res_lin10 AS
SELECT a.event_index, a.duckvep_event_kind,
  coalesce(t.transcript_stable_id, fe.feature_class || ':' || fe.stable_id, 'none') AS object,
  a.consequence_mask, a.region_mask, a.impact_code, a.status_code, a.reason_code,
  a.cdna_position, a.cds_position, a.protein_position,
  a.reference_amino_acid_code, a.alternate_amino_acid_code, a.nmd_prediction_code,
  a.nmd_escape_reasons, a.overlap_object_code,
  a.transcript_hgvs, a.protein_hgvs, a.hgvs_shift, a.transcript_hgvs_status,
  a.transcript_hgvs_reason, a.protein_hgvs_status, a.protein_hgvs_reason
FROM query(duckvep_annotate_sql('ev_lin10', 'lin_10',
  struct_pack(hgvs := true, upstream_distance := 40, downstream_distance := 40))) a
LEFT JOIN transcripts_lin10 t ON t.transcript_index = a.transcript_index
LEFT JOIN features_lin10 fe ON fe.regulation_feature_index = a.regulation_feature_index;


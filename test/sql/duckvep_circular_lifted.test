query TIII
WITH r AS (SELECT object, event_index, terms(consequence_mask) AS t FROM res_0
  WHERE object IN ('T_NB', 'T_NF') AND event_index % 100 = 0)
SELECT object, count(*), min(event_index // 100), max(event_index // 100)
FROM r WHERE t = 'upstream_gene_variant' GROUP BY 1 ORDER BY 1;
----
T_NB	40	1	3000
T_NF	40	1	3000

statement ok
CREATE TABLE res_default_0 AS
SELECT a.event_index, coalesce(t.transcript_stable_id, f.feature_class || ':' || f.stable_id, 'none') AS object,
  a.consequence_mask, a.region_mask, a.impact_code, a.cdna_position, a.cds_position, a.protein_position,
  a.transcript_hgvs, a.protein_hgvs, a.nmd_prediction_code
FROM query(duckvep_annotate_sql('ev_0', 'circ_0', struct_pack(hgvs := true))) a
LEFT JOIN transcripts_0 t ON t.transcript_index = a.transcript_index
LEFT JOIN features_0 f ON f.regulation_feature_index = a.regulation_feature_index
WHERE a.event_index % 7 = 0;

statement ok
CREATE TABLE res_default_611 AS
SELECT a.event_index, coalesce(t.transcript_stable_id, f.feature_class || ':' || f.stable_id, 'none') AS object,
  a.consequence_mask, a.region_mask, a.impact_code, a.cdna_position, a.cds_position, a.protein_position,
  a.transcript_hgvs, a.protein_hgvs, a.nmd_prediction_code
FROM query(duckvep_annotate_sql('ev_611', 'circ_611', struct_pack(hgvs := true))) a
LEFT JOIN transcripts_611 t ON t.transcript_index = a.transcript_index
LEFT JOIN features_611 f ON f.regulation_feature_index = a.regulation_feature_index
WHERE a.event_index % 7 = 0;


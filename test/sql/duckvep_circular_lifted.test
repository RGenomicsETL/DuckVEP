CREATE SCHEMA core_0;

statement ok
CREATE SCHEMA funcgen_0;

statement ok
CREATE VIEW core_0.coord_system AS SELECT * FROM core.coord_system;

statement ok
CREATE VIEW core_0.seq_region AS SELECT * FROM core.seq_region;

statement ok
CREATE VIEW core_0.attrib_type AS SELECT * FROM core.attrib_type;

statement ok
CREATE VIEW core_0.seq_region_attrib AS SELECT * FROM core.seq_region_attrib;

statement ok
CREATE VIEW core_0.gene AS SELECT * FROM core.gene;

statement ok
CREATE VIEW core_0.exon_transcript AS SELECT * FROM core.exon_transcript;

statement ok
CREATE VIEW core_0.translation AS SELECT * FROM core.translation;

statement ok
CREATE VIEW core_0.transcript_attrib AS SELECT * FROM core.transcript_attrib;

statement ok
CREATE VIEW core_0.translation_attrib AS SELECT * FROM core.translation_attrib;

statement ok
CREATE TABLE core_0.transcript AS SELECT transcript_id, gene_id, seq_region_id,
  rot(seq_region_start, 0) AS seq_region_start, rot(seq_region_end, 0) AS seq_region_end,
  seq_region_strand, biotype, is_current, stable_id, version FROM core.transcript;

statement ok
CREATE TABLE core_0.exon AS SELECT exon_id, seq_region_id,
  rot(seq_region_start, 0) AS seq_region_start, rot(seq_region_end, 0) AS seq_region_end,
  seq_region_strand, phase, end_phase, is_current, stable_id FROM core.exon;

statement ok
CREATE VIEW funcgen_0.feature_type AS SELECT * FROM funcgen.feature_type;

statement ok
CREATE TABLE funcgen_0.regulatory_feature AS SELECT regulatory_feature_id, feature_type_id,
  seq_region_id, seq_region_strand, rot(seq_region_start, 0) AS seq_region_start,
  rot(seq_region_end, 0) AS seq_region_end, stable_id, regulatory_build_id FROM funcgen.regulatory_feature;

statement ok
CREATE TABLE funcgen_0.motif_feature AS SELECT motif_feature_id, binding_matrix_id,
  seq_region_id, rot(seq_region_start, 0) AS seq_region_start, rot(seq_region_end, 0) AS seq_region_end,
  seq_region_strand, score, stable_id FROM funcgen.motif_feature;

statement ok
CREATE TABLE ref_0 AS SELECT * FROM ref;

statement ok
COPY (SELECT line FROM (SELECT 0 AS o, '>' || chrom AS line FROM ref_0
  UNION ALL SELECT 1, seq FROM ref_0) ORDER BY o) TO '__TEST_DIR__/circular_0.fa'
  (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

statement ok
COPY (SELECT chrom, 3000, length('>' || chrom) + 1, 3000, 3000 + 1 FROM ref_0)
  TO '__TEST_DIR__/circular_0.fa.fai' (FORMAT csv, HEADER false, DELIMITER '	', QUOTE '', ESCAPE '');

statement ok
CREATE TABLE regions_0 AS FROM query(duckvep_ensembl_regions_sql('core_0', 'ref_0', 'synthetic'));

statement ok
CREATE TABLE transcripts_0 AS FROM query(duckvep_ensembl_transcripts_sql('core_0', 'ref_0', 'synthetic'));

statement ok
CREATE TABLE features_0 AS FROM query(duckvep_ensembl_regulation_features_sql('funcgen_0', 'regions_0'));

query I
SELECT loaded FROM duckvep_model_load(
  'circ_0',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions_0 ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts_0 ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts_0, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  interval_feature_query := 'SELECT regulation_feature_index, seq_region, feature_start, feature_end, feature_kind FROM features_0 ORDER BY regulation_feature_index',
  reference_fasta := '__TEST_DIR__/circular_0.fa'
);
----
1

statement ok
CREATE TABLE ev_0 AS SELECT e.event_index, (SELECT seq_region FROM regions_0) AS seq_region,
  rot(e.u_pos, 0)::UBIGINT AS position,
  substr(r.seq || r.seq, rot(e.u_pos, 0), e.ref_length) AS reference,
  e.alt AS alternate, NULL::UBIGINT AS end_position, NULL::VARCHAR AS structural_type,
  NULL::VARCHAR AS copy_change, NULL::UINTEGER AS mate_seq_region, NULL::UBIGINT AS mate_position
  FROM ev0 e, ref_0 r;

statement ok
CREATE TABLE res_0 AS
SELECT a.event_index, a.duckvep_event_kind,
  coalesce(t.transcript_stable_id, f.feature_class || ':' || f.stable_id, 'none') AS object,
  a.consequence_mask, a.region_mask, a.impact_code, a.status_code, a.reason_code,
  a.cdna_position, a.cds_position, a.protein_position,
  a.reference_amino_acid_code, a.alternate_amino_acid_code, a.nmd_prediction_code,
  a.nmd_escape_reasons, a.overlap_object_code,
  a.transcript_hgvs, a.protein_hgvs, a.hgvs_shift, a.transcript_hgvs_status,
  a.transcript_hgvs_reason, a.protein_hgvs_status, a.protein_hgvs_reason
FROM query(duckvep_annotate_sql('ev_0', 'circ_0',
  struct_pack(hgvs := true, upstream_distance := 40, downstream_distance := 40))) a
LEFT JOIN transcripts_0 t ON t.transcript_index = a.transcript_index
LEFT JOIN features_0 f ON f.regulation_feature_index = a.regulation_feature_index;


# name: test/sql/duckvep_csq.test
# description: CSQ, BCSQ, exact and region annotations from DuckDB Parquet fixtures
# group: [duckvep]

require duckvep

query IT
SELECT count(*), string_agg(column_name, ',' ORDER BY column_name)
FROM (DESCRIBE SELECT CHROM, POS, ID, REF, ALT, QUAL, FILTER,
  VEP_Allele, VEP_Consequence, VEP_Feature_type, VEP_Feature, VEP_Amino_acids, VEP_SIFT
FROM read_parquet('__WORKING_DIRECTORY__/test/data/duckvep/ensembl_release_consequences.parquet'));
----
13	ALT,CHROM,FILTER,ID,POS,QUAL,REF,VEP_Allele,VEP_Amino_acids,VEP_Consequence,VEP_Feature,VEP_Feature_type,VEP_SIFT

query II
SELECT list_count(VEP_Consequence), list_count(INFO_VE)
FROM read_parquet('__WORKING_DIRECTORY__/test/data/duckvep/ensembl_release_consequences.parquet')
WHERE POS = 15528198;
----
4	6

query T
SELECT string_agg(list_extract(VEP_Allele, ordinal) || ':' ||
                  list_extract(VEP_Consequence, ordinal) || ':' ||
                  list_extract(VEP_Feature, ordinal), ',' ORDER BY ordinal)
FROM read_parquet('__WORKING_DIRECTORY__/test/data/duckvep/ensembl_release_consequences.parquet'),
     UNNEST(range(1, list_count(VEP_Allele) + 1)) AS u(ordinal)
WHERE POS = 15528198;
----
A:missense_variant:ENST00000643195,A:intron_variant:ENST00000775238,T:intron_variant:ENST00000775238,T:missense_variant:ENST00000643195

query TTTTT
SELECT list_extract(VEP_Consequence, 1), list_extract(VEP_gene, 1),
       list_extract(VEP_transcript, 1), list_extract(VEP_strand, 1),
       list_extract(VEP_dna_change, 1)
FROM read_parquet('__WORKING_DIRECTORY__/test/data/duckvep/minimal_bcsq.parquet')
WHERE POS = 124;
----
missense_variant	DUCK1	DUCK1-201	+	124T>C

query TT
SELECT typeof(VEP_Consequence), typeof(VEP_dna_change)
FROM read_parquet('__WORKING_DIRECTORY__/test/data/duckvep/minimal_bcsq.parquet') LIMIT 1;
----
VARCHAR[]	VARCHAR[]

query TT
WITH variants AS (
  SELECT CHROM, POS, REF, list_extract(ALT, 1) AS ALT, ID
  FROM read_parquet('__WORKING_DIRECTORY__/test/data/duckvep/minimal_bcsq.parquet')
), exact_annotations(chrom, pos, ref, alt, label) AS (
  VALUES ('chrDuck', 124::BIGINT, 'T', 'C', 'pinned_exact_missense')
)
SELECT v.ID, a.label FROM variants v JOIN exact_annotations a
  ON v.CHROM = a.chrom AND v.POS = a.pos AND v.REF = a.ref AND v.ALT = a.alt;
----
duck_missense	pinned_exact_missense

query T
WITH variants AS (
  SELECT CHROM, POS, ID
  FROM read_parquet('__WORKING_DIRECTORY__/test/data/duckvep/minimal_bcsq.parquet')
), genes AS (
  SELECT seqname, start, "end", map_extract_value(attributes_map, 'ID') AS gene_id
  FROM read_parquet('__WORKING_DIRECTORY__/test/data/duckvep/minimal_gff.parquet')
  WHERE feature = 'gene'
)
SELECT string_agg(v.ID || ':' || coalesce(g.gene_id, 'NA'), ',' ORDER BY v.CHROM, v.POS)
FROM variants v LEFT JOIN genes g ON v.CHROM = g.seqname AND v.POS BETWEEN g.start AND g."end";
----
duck_missense:gene:DUCK1,duck_intron:gene:DUCK1,duck_intergenic:NA

require duckvep

statement ok
SELECT * FROM duckvep_model_load('compatible_overlap',
  'SELECT i::UINTEGER seq_region FROM range(2) t(i)',
  'SELECT i::UINTEGER transcript_index,i::UINTEGER seq_region,100::UBIGINT transcript_start,111::UBIGINT transcript_end,(1-2*i)::TINYINT strand,0::UINTEGER gene_index,3::UBIGINT transcript_flags,100::UBIGINT cds_start,111::UBIGINT cds_end,''ATGGCTGAATAA''::BLOB cds_sequence,1::UTINYINT codon_table,''''::BLOB pre_cds_sequence,''''::BLOB post_cds_sequence FROM range(2) t(i)',
  'SELECT i::UINTEGER transcript_index,100::UBIGINT exon_start,111::UBIGINT exon_end,1::UBIGINT exon_cdna_start,12::UBIGINT exon_cdna_end,0::TINYINT phase,0::TINYINT end_phase FROM range(2) t(i)')

statement ok
CREATE TABLE overlap_calls AS SELECT * FROM (VALUES
 (1,0,103,'GC','AT',1,0,0,[0,1],[false,true],77::BIGINT),
 (2,0,104,'CT','TT',1,0,0,[0,1],[false,true],77::BIGINT),
 (3,1,107,'GC','AT',1,1,0,[0,1],[false,true],77::BIGINT),
 (4,1,106,'AG','AA',1,1,0,[0,1],[false,true],77::BIGINT))
 v(event_index,seq_region,position,reference,alternate,alt_index,transcript_index,sample_index,alleles,phase_before,phase_set)

statement ok
CREATE TABLE overlap_result AS SELECT * FROM duckvep_haplotypes('SELECT * FROM overlap_calls ORDER BY event_index DESC','compatible_overlap',phase_policy := 'strict',hgvs := true)

query IIIII
SELECT count(*),count(*) FILTER(WHERE cds='ATGATTGAATAA' AND protein='MIE*'),
 count(*) FILTER(WHERE hgvsc='c.4_5delinsAT' AND hgvsp='p.(Ala2Ile)'),
 count(*) FILTER(WHERE len(contributors)=2 AND len(coding_blocks)=1 AND len(coding_blocks[1].event_indices)=2),
 count(*) FILTER(WHERE carriers[1].phase_set=77 AND carriers[1].haplotype_lane=2 AND carriers[1].ploidy=2)
FROM overlap_result
----
2	2	2	2	2

query III
SELECT count(*),count(*) FILTER(WHERE c.position=s.position AND c.reference=s.reference AND c.alternate=s.alternate),
 count(*) FILTER(WHERE s.alleles=[0,1] AND s.phase_before=[false,true] AND s.phase_set=77)
FROM overlap_result r,unnest(r.contributors) u(c) JOIN overlap_calls s ON c.event_index=s.event_index
----
4	4	4

statement ok
UPDATE overlap_calls SET alternate=CASE WHEN seq_region=0 THEN 'GT' ELSE 'AC' END WHERE event_index IN (2,4)

query IIII
SELECT count(*),count(*) FILTER(WHERE cds IS NULL AND protein IS NULL AND hgvsc IS NULL AND hgvsp IS NULL),
 count(*) FILTER(WHERE prediction_status='edit_conflict' AND haplotype_consequences IS NULL AND nmd_prediction='unknown'),
 count(*) FILTER(WHERE len(contributors)=2)
FROM duckvep_haplotypes('SELECT * FROM overlap_calls','compatible_overlap',phase_policy := 'strict',hgvs := true)
----
2	2	2	2

statement ok
SELECT * FROM duckvep_model_load('ov_multi','SELECT 0::UINTEGER seq_region','SELECT 0::UINTEGER transcript_index,0::UINTEGER seq_region,100::UBIGINT transcript_start,114::UBIGINT transcript_end,1::TINYINT strand,0::UINTEGER gene_index,3::UBIGINT transcript_flags,100::UBIGINT cds_start,114::UBIGINT cds_end,''ATGGCTGAATTTTAA''::BLOB cds_sequence,1::UTINYINT codon_table','SELECT 0::UINTEGER transcript_index,100::UBIGINT exon_start,114::UBIGINT exon_end,1::UBIGINT exon_cdna_start,15::UBIGINT exon_cdna_end,0::TINYINT phase,0::TINYINT end_phase')

statement ok
CREATE TABLE ov_multi_calls AS SELECT * FROM (VALUES (1,0,103,'GCTGAATT','ATTGAACT',1,0,0,[0,1],[false,true],77::BIGINT),(2,0,104,'CT','TT',1,0,0,[0,1],[false,true],77::BIGINT),(3,0,103,'GCTGAATT','ATTGAACT',1,0,0,[0,1],[false,true],77::BIGINT)) v(event_index,seq_region,position,reference,alternate,alt_index,transcript_index,sample_index,alleles,phase_before,phase_set)

query IIIIIII
SELECT cds='ATGATTGAACTTTAA',protein='MIEL*',hgvsc='c.[4_5delinsAT;10T>C]',hgvsp='p.[(Ala2Ile;Phe4Leu)]',list_sort(coding_blocks[1].event_indices)=[1,2,3],list_sort(coding_blocks[2].event_indices)=[1,3],(SELECT bool_and(e.block_index=CASE WHEN e.cds_start<7 THEN 0 ELSE 1 END) FROM unnest(normalized_edits) t(e)) FROM duckvep_haplotypes('SELECT * FROM ov_multi_calls ORDER BY event_index DESC','ov_multi',phase_policy:='strict',hgvs:=true)
----
true	true	true	true	true	true	true

statement ok
UPDATE ov_multi_calls SET position=106,reference='G',alternate='A' WHERE event_index=3

query IIIIIII
SELECT cds='ATGATTAAACTTTAA',protein='MIKL*',list_sort(coding_blocks[1].event_indices)=[1,2],coding_blocks[2].event_indices=[3],coding_blocks[3].event_indices=[1],len(normalized_edits)=4,(SELECT bool_and(e.event_index<>1 OR e.block_index<>1) FROM unnest(normalized_edits) t(e)) FROM duckvep_haplotypes('SELECT * FROM ov_multi_calls','ov_multi',hgvs:=true)
----
true	true	true	true	true	true	true

statement ok
UPDATE ov_multi_calls SET position=CASE WHEN event_index=3 THEN 107 ELSE 103 END,reference=CASE event_index WHEN 1 THEN 'GCTGA' WHEN 2 THEN 'GCT' ELSE 'A' END,alternate=CASE event_index WHEN 1 THEN 'TAAGC' WHEN 2 THEN 'TAA' ELSE 'C' END

query IIIIIIIII
SELECT cds='ATGTAAGCATTTTAA',protein='M*',list_sort(nmd_contributors)=[1,2],nmd_prediction='escape',nmd_stop_position=6,nmd_junction_position IS NULL,nmd_exceptions='start_proximal',list_transform(list_sort(contributor_provenance),lambda c: c.role)=['applied','applied','post_stop'],list_sort(coding_blocks[2].event_indices)=[1,3] FROM duckvep_haplotypes('SELECT * FROM ov_multi_calls','ov_multi',hgvs:=true)
----
true	true	true	true	true	true	true	true	true

# Intersecting literal indel islands on ATG GCT GAA TAA. One sample per witness; samples 6 and 7
# repeat witnesses 0 and 3 on the reverse-strand transcript.
statement ok
CREATE TABLE indel_calls AS SELECT * FROM (VALUES
 (1,0,102,'GGCT','G',1,0,0),(2,0,102,'GGCT','G',1,0,0),
 (3,0,102,'GGCTGAA','G',1,0,1),(4,0,103,'GCT','G',1,0,1),
 (5,0,105,'T','TCCC',1,0,2),(6,0,105,'T','TCCC',1,0,2),
 (7,0,105,'T','TCCC',1,0,3),(8,0,106,'G','A',1,0,3),
 (9,0,103,'GCT','G',1,0,4),(10,0,104,'C','A',1,0,4),
 (11,0,102,'GGCT','G',1,0,5),(12,0,103,'GCT','G',1,0,5),
 (13,1,105,'CAGC','C',1,1,6),(14,1,105,'CAGC','C',1,1,6),
 (15,1,105,'C','CGGG',1,1,7),(16,1,105,'C','T',1,1,7))
 v(event_index,seq_region,position,reference,alternate,alt_index,transcript_index,sample_index)

statement ok
CREATE TABLE indel_result AS SELECT * FROM duckvep_haplotypes('SELECT *,[0,1] alleles,[false,true] phase_before,77::BIGINT phase_set FROM indel_calls ORDER BY seq_region,position,event_index','compatible_overlap',phase_policy:='strict',hgvs:=true)

query IIIIIIII
SELECT carriers[1].sample_index,prediction_status,cds,protein,hgvsc,hgvsp,
 list_transform(coding_blocks,lambda b: list_sort(b.event_indices)),
 list_transform(list_sort(contributor_provenance),lambda c: c.role)
FROM indel_result
ORDER BY 1
----
0	predicted	ATGGAATAA	ME*	c.5_7del	p.(Ala2del)	[[1, 2]]	[applied, applied]
1	predicted	ATGTAA	M*	c.4_9del	p.(Ala2_Glu3del)	[[3, 4]]	[applied, applied]
2	predicted	ATGGCTCCCGAATAA	MAPE*	c.6_7insCCC	p.(Ala2_Glu3insPro)	[[5, 6]]	[applied, applied]
3	predicted	ATGGCTCCCAAATAA	MAPK*	c.7delinsCCCA	p.(Glu3delinsProLys)	[[7, 8]]	[applied, applied]
4	edit_conflict	NULL	NULL	NULL	NULL	NULL	[unapplied, unapplied]
5	predicted	ATGGAATAA	ME*	c.5_7del	p.(Ala2del)	[[11, 12]]	[applied, applied]
6	predicted	ATGGAATAA	ME*	c.5_7del	p.(Ala2del)	[[13, 14]]	[applied, applied]
7	predicted	ATGGCTCCCAAATAA	MAPK*	c.7delinsCCCA	p.(Glu3delinsProLys)	[[15, 16]]	[applied, applied]

# Source records survive verbatim and every source keeps its own normalized island.
query III
SELECT count(*),count(*) FILTER(WHERE c.position=s.position AND c.reference=s.reference AND c.alternate=s.alternate),
 count(*) FILTER(WHERE c.event_index IN (SELECT unnest(r2.normalized_edits).event_index FROM indel_result r2 WHERE r2.carriers[1].sample_index=r.carriers[1].sample_index))
FROM indel_result r,unnest(r.contributors) u(c) JOIN indel_calls s ON c.event_index=s.event_index
----
16	16	16

# Two-exon transcript, CDS ATG AAA GCT GAA (CTG x25) TAA, exon 1 is cDNA 1..60. A redundant duplicate
# source adds provenance only: samples 0/1 (duplicate c.4_6del) and 2/3 (duplicate stop MNV c.7_9)
# keep the single-source blocks and HGVSp, and the abutting c.10G>A stays its own post-stop block.
# Samples 4/5: the deletion record removes c.11 at its own coordinates and c.11A>T substitutes that
# base, in either source order: a contradiction. Records apply literally; an equivalent placement
# elsewhere in the AA run is not a second reading.
statement ok
SELECT loaded FROM duckvep_model_load('two_exon',
 'SELECT 0::UINTEGER seq_region',
 'SELECT 0::UINTEGER transcript_index,0::UINTEGER seq_region,1001::UBIGINT transcript_start,2030::UBIGINT transcript_end,1::TINYINT strand,0::UINTEGER gene_index,3::UBIGINT transcript_flags,1001::UBIGINT cds_start,2030::UBIGINT cds_end,(''ATGAAAGCTGAA''||repeat(''CTG'',25)||''TAA'')::BLOB cds_sequence,1::UTINYINT codon_table',
 'SELECT * FROM (VALUES (0::UINTEGER,1001::UBIGINT,1060::UBIGINT,1::UBIGINT,60::UBIGINT,0::TINYINT,0::TINYINT),(0::UINTEGER,2001::UBIGINT,2030::UBIGINT,61::UBIGINT,90::UBIGINT,0::TINYINT,0::TINYINT)) v(transcript_index,exon_start,exon_end,exon_cdna_start,exon_cdna_end,phase,end_phase)')

statement ok
CREATE TABLE dup_calls AS SELECT * FROM (VALUES
 (1,0,1003,'GAAA','G',1,0,0),(2,0,1003,'GAAA','G',1,0,0),(3,0,1007,'GCT','TAA',1,0,0),(4,0,1010,'G','A',1,0,0),
 (11,0,1003,'GAAA','G',1,0,1),(13,0,1007,'GCT','TAA',1,0,1),(14,0,1010,'G','A',1,0,1),
 (21,0,1007,'GCT','TAA',1,0,2),(22,0,1007,'GCT','TAA',1,0,2),(23,0,1010,'G','A',1,0,2),
 (31,0,1007,'GCT','TAA',1,0,3),(33,0,1010,'G','A',1,0,3),
 (41,0,1010,'GA','G',1,0,4),(42,0,1011,'A','T',1,0,4),
 (51,0,1011,'A','T',1,0,5),(52,0,1010,'GA','G',1,0,5))
 v(event_index,seq_region,position,reference,alternate,alt_index,transcript_index,sample_index)

query IIIIIII
SELECT carriers[1].sample_index,prediction_status,protein,hgvsc,hgvsp,
 list_transform(coding_blocks,lambda b: list_sort(b.event_indices)),
 list_transform(list_sort(contributor_provenance),lambda c: c.role)
FROM duckvep_haplotypes('SELECT *,[0,1] alleles,[false,true] phase_before,77::BIGINT phase_set FROM dup_calls ORDER BY seq_region,position,event_index','two_exon',phase_policy:='strict',hgvs:=true)
ORDER BY 1
----
0	predicted	M*	c.4_10delinsTAAA	p.(Lys2Ter)	[[1, 2, 3], [4]]	[applied, applied, applied, post_stop]
1	predicted	M*	c.4_10delinsTAAA	p.(Lys2Ter)	[[11, 13], [14]]	[applied, applied, post_stop]
2	predicted	MK*	c.7_10delinsTAAA	p.(Ala3Ter)	[[21, 22], [23]]	[applied, applied, post_stop]
3	predicted	MK*	c.7_10delinsTAAA	p.(Ala3Ter)	[[31], [33]]	[applied, post_stop]
4	edit_conflict	NULL	NULL	NULL	NULL	[unapplied, unapplied]
5	edit_conflict	NULL	NULL	NULL	NULL	[unapplied, unapplied]

CREATE TABLE regions AS FROM query(duckvep_ensembl_regions_sql('core', 'ref', 'synthetic'));

query TII
SELECT seq_region_name, sequence_length, CAST(circular AS INTEGER) FROM regions;
----
C	40	1

statement ok
CREATE TABLE transcripts AS FROM query(duckvep_ensembl_transcripts_sql('core', 'ref', 'synthetic'));

query TTIIIII
SELECT transcript_stable_id, CAST(origin_crossing AS VARCHAR), transcript_start, transcript_end,
  exons[1].rank, exons[1].exon_start, exons[1].exon_end
FROM transcripts ORDER BY transcript_stable_id;
----
T_MINUS	true	30	7	1	1	7
T_PLUS	true	35	8	1	35	40
T_RNA	true	38	3	1	38	3
T_SINGLE	true	37	4	1	37	4

query TIII
SELECT transcript_stable_id, exons[2].exon_start, exons[2].exon_end, exons[2].exon_cdna_start
FROM transcripts WHERE transcript_stable_id IN ('T_MINUS', 'T_PLUS') ORDER BY transcript_stable_id;
----
T_MINUS	30	40	8
T_PLUS	1	8	7

statement ok
CREATE TABLE features AS FROM query(duckvep_ensembl_regulation_features_sql('funcgen', 'regions'));

query TTII
SELECT feature_class, CAST(origin_crossing AS VARCHAR), feature_start, feature_end
FROM features ORDER BY feature_class;
----
regulatory_region	true	38	4
transcription_factor_binding_site	true	39	2

query III
SELECT circular_region_count, transcript_count, regulation_feature_count
FROM query(duckvep_model_receipt_sql(
  'regions', 'transcripts', 'Ensembl', '116', 'synthetic', repeat('a', 64),
  repeat('b', 64), 'circular source transcripts',
  {regulation_features_table: 'features'}));
----
1	4	2

query I
SELECT loaded FROM duckvep_model_load(
  'synthetic-circular',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions ORDER BY seq_region',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  interval_feature_query := 'SELECT regulation_feature_index, seq_region, feature_start, feature_end, feature_kind FROM features ORDER BY regulation_feature_index'
);
----
1

statement error
SELECT loaded FROM duckvep_model_load(
  'synthetic-linear-mismatch',
  'SELECT seq_region, sequence_length, seq_region_name, false AS circular FROM regions',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start'
);
----
transcript row has an invalid region, span, or strand

statement error
SELECT loaded FROM duckvep_model_load(
  'synthetic-invalid-exon',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, CASE WHEN exon.exon_start = 38 THEN 41 ELSE exon.exon_start END AS exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start'
);
----
exon row has invalid coordinates or phase

statement error
SELECT loaded FROM duckvep_model_load(
  'synthetic-invalid-feature',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start',
  interval_feature_query := 'SELECT regulation_feature_index, seq_region, 41::UINTEGER AS feature_start, feature_end, feature_kind FROM features ORDER BY regulation_feature_index'
);
----
interval-feature row has an invalid dense index, region, coordinate, or kind

statement error
SELECT loaded FROM duckvep_model_load(
  'synthetic-invalid-cdna',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, exon.exon_start, exon.exon_end, exon.exon_cdna_start, CAST(exon.exon_cdna_end + CASE WHEN exon.exon_start = 38 THEN 1 ELSE 0 END AS UBIGINT) AS exon_cdna_end, exon.phase, exon.end_phase FROM transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start'
);
----
circular exon cDNA length does not match its genomic span

statement error
SELECT loaded FROM duckvep_model_load(
  'synthetic-no-crossing',
  'SELECT seq_region, sequence_length, seq_region_name, circular FROM regions',
  'SELECT transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end, cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence FROM transcripts ORDER BY seq_region, transcript_start, transcript_index',
  'SELECT transcript_index, CASE WHEN exon.exon_start = 35 THEN 9 ELSE exon.exon_start END AS exon_start, CASE WHEN exon.exon_start = 35 THEN 14 ELSE exon.exon_end END AS exon_end, exon.exon_cdna_start, exon.exon_cdna_end, exon.phase, exon.end_phase FROM transcripts, LATERAL unnest(exons) AS u(exon) ORDER BY transcript_index, exon.exon_cdna_start'
);
----
exon row has invalid coordinates or phase


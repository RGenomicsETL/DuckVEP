----
require a loaded model name

query I
SELECT loaded FROM duckvep_model_load('cc_unnamed', 'SELECT i::UINTEGER seq_region, 1000::UBIGINT sequence_length FROM range(3) t(i)',
 'SELECT * FROM cc_tx ORDER BY seq_region, transcript_start, transcript_index',
 'SELECT * FROM cc_ex ORDER BY transcript_index, exon_cdna_start',
 transcript_coverage_complete := TRUE);
----
1

statement error
SELECT count(*) FROM duckvep_coding_calls('cc_unnamed', 'test/data/coding_calls/cases.vcf');
----
has no seq_region_name values

statement ok
SELECT duckvep_model_drop('cc_unnamed');

statement ok
SELECT duckvep_model_drop('cc');

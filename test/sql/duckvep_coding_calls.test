1216	2	440	AT	A	1	5	0	[0, 1]	[false, true]	3

# The bgzipped text and the BCF form of the same file give the same calls.

query II
SELECT (SELECT count(*) FROM (SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.vcf') EXCEPT ALL SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.vcf.gz'))),
 (SELECT count(*) FROM (SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.vcf.gz') EXCEPT ALL SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.vcf')));
----
0	0

query II
SELECT (SELECT count(*) FROM (SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.vcf') EXCEPT ALL SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.bcf'))),
 (SELECT count(*) FROM (SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.bcf') EXCEPT ALL SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.vcf')));
----
0	0

# The reader equals the SQL construction of the mode B scale worker (read_csv of the text, duckvep_coding_transcripts per ALT allele, GT and PS parsed
# from the sample text), as multisets and on every column.

statement ok
CREATE TABLE cc_regions AS SELECT i::BIGINT seq_region, 'c' || i seq_region_name FROM range(3) t(i);

statement ok
CREATE TABLE cc_modeb AS SELECT ((c.record_index << 6) | (c.i - 1))::BIGINT AS event_index, c.seq_region::INTEGER AS seq_region,
 c.pos::BIGINT AS position, c.ref AS reference, c.alt AS alternate, c.i::INTEGER AS alt_index, t.transcript_index::INTEGER AS transcript_index,
 0::INTEGER AS sample_index, list_transform(string_split_regex(split_part(c.sample, ':', 1), '[/|]'), lambda x: try_cast(x AS INTEGER)) AS alleles,
 [false] || list_transform(regexp_extract_all(split_part(c.sample, ':', 1), '[/|]'), lambda s: s = '|') AS phase_before,
 try_cast(list_last(string_split(c.sample, ':')) AS BIGINT) AS phase_set
 FROM (SELECT * FROM (SELECT v.record_index, a.i, r.seq_region, v.pos, v.ref, a.alt AS alt, v.sample,
   duckvep_coding_transcripts('cc', r.seq_region, v.pos, v.ref, a.alt) AS tx
   FROM (SELECT row_number() OVER () AS record_index, chrom, pos, ref, alt, sample FROM read_csv('test/data/coding_calls/cases.vcf', delim='\t', header=false, skip=8,
    auto_detect=false, quote='', escape='', strict_mode=false,
    columns={'chrom':'VARCHAR','pos':'BIGINT','id':'VARCHAR','ref':'VARCHAR','alt':'VARCHAR','qual':'VARCHAR','filter':'VARCHAR','info':'VARCHAR','fmt':'VARCHAR','sample':'VARCHAR'})) v
   JOIN cc_regions r ON r.seq_region_name = v.chrom, unnest(string_split(v.alt, ',')) WITH ORDINALITY a(alt, i) WHERE v.alt <> '.') WHERE len(tx) > 0) c, unnest(c.tx) t(transcript_index);

query III
SELECT (SELECT count(*) FROM cc_modeb),
 (SELECT count(*) FROM (SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.vcf') EXCEPT ALL SELECT * FROM cc_modeb)),
 (SELECT count(*) FROM (SELECT * FROM cc_modeb EXCEPT ALL SELECT * FROM duckvep_coding_calls('cc', 'test/data/coding_calls/cases.vcf')));
----
23	0	0

# duckvep_haplotypes over the reader and over the mode B calls write the same rows (diploid calls only: the consumer requires one ploidy per
# transcript, and the haploid and triploid records share transcript 4 with a diploid one).

statement ok
CREATE TABLE cc_hap_reader AS SELECT * FROM duckvep_haplotypes('SELECT * FROM duckvep_coding_calls(''cc'', ''test/data/coding_calls/cases.vcf'') WHERE len(alleles) = 2', 'cc');

statement ok
CREATE TABLE cc_hap_modeb AS SELECT * FROM duckvep_haplotypes('SELECT * FROM cc_modeb WHERE len(alleles) = 2', 'cc');

query III
SELECT (SELECT count(*) FROM cc_hap_reader) > 0, (SELECT count(*) FROM (SELECT * FROM cc_hap_reader EXCEPT ALL SELECT * FROM cc_hap_modeb)),
 (SELECT count(*) FROM (SELECT * FROM cc_hap_modeb EXCEPT ALL SELECT * FROM cc_hap_reader));
----
true	0	0

# Several samples: sample_index is the column order, a missing genotype is [NULL, NULL], the PS of each sample is its own (Type=Integer here), a record
# that touches no coding sequence (c0:50) is never decoded but counted (record 2), and a record with only GT has no phase set.

query IIIIIIIIIII
SELECT event_index, seq_region, position, reference, alternate, alt_index, transcript_index, sample_index, alleles, phase_before, phase_set
FROM duckvep_coding_calls('cc', 'test/data/coding_calls/multi.vcf') ORDER BY event_index, transcript_index, sample_index;
----
64	0	104	A	C	1	0	0	[0, 1]	[false, true]	10
64	0	104	A	C	1	0	1	[1, 2]	[false, true]	20
64	0	104	A	C	1	0	2	[NULL, NULL]	[false, false]	NULL
64	0	104	A	C	1	1	0	[0, 1]	[false, true]	10
64	0	104	A	C	1	1	1	[1, 2]	[false, true]	20
64	0	104	A	C	1	1	2	[NULL, NULL]	[false, false]	NULL
65	0	104	A	G	2	0	0	[0, 1]	[false, true]	10
65	0	104	A	G	2	0	1	[1, 2]	[false, true]	20
65	0	104	A	G	2	0	2	[NULL, NULL]	[false, false]	NULL
65	0	104	A	G	2	1	0	[0, 1]	[false, true]	10
65	0	104	A	G	2	1	1	[1, 2]	[false, true]	20
65	0	104	A	G	2	1	2	[NULL, NULL]	[false, false]	NULL
192	0	120	A	G	1	0	0	[1, 1]	[false, false]	NULL
192	0	120	A	G	1	0	1	[0, 1]	[false, true]	NULL
192	0	120	A	G	1	0	2	[1, 0]	[false, true]	NULL

# Explicit errors, never silent: a record without GT that touches coding sequence (the c0:50 record without GT is skipped), a header with no
# FORMAT/GT, a file without samples, more than 64 ALT alleles, a file that is not a VCF, an invalid POS, a missing file, an unknown model,
# NULL arguments, and a model loaded without region names.

statement error
SELECT count(*) FROM duckvep_coding_calls('cc', 'test/data/coding_calls/no_gt_record.vcf');
----
record 2 at position 104 has no GT

statement error
SELECT count(*) FROM duckvep_coding_calls('cc', 'test/data/coding_calls/no_gt_header.vcf');
----
declares no FORMAT/GT field


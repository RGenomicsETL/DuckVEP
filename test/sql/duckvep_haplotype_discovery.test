# name: test/sql/duckvep_haplotype_discovery.test
# description: duckvep_coding_transcripts, discovery of the transcripts whose CDS an event overlaps, equal to the annotation builder's pairs
# group: [duckvep]

require duckvep

# Six transcripts on three regions. 0: plus strand, exons 100-110 and 120-132, CDS 103-129 (UTR bases at both ends).
# 1: plus strand, exons 104-108 and 125-131, all coding, overlapping transcript 0. 2: non-coding, exon 105-115.
# 3: minus strand on region 1, exons 220-232 and 200-210, CDS 203-229. Transcripts 0 and 3 have 9-base introns, which VEP counts as
# coding (frameshift introns); transcripts 4 (plus, region 2) and 5 (minus) are all-coding with 29-base introns, CDS 300-349 and 400-449.

statement ok
CREATE TABLE dc_tx AS SELECT * FROM (VALUES
 (0::UINTEGER, 0::UINTEGER, 100::UBIGINT, 132::UBIGINT, 1::TINYINT, 0::UINTEGER, 3::UBIGINT, 103::UBIGINT, 129::UBIGINT,
  'ATGAAACCCGGGTTTTAA'::BLOB, 1::UTINYINT, 'AAA'::BLOB, 'CCC'::BLOB),
 (1::UINTEGER, 0::UINTEGER, 104::UBIGINT, 131::UBIGINT, 1::TINYINT, 1::UINTEGER, 3::UBIGINT, 104::UBIGINT, 131::UBIGINT,
  'ATGAAACCCTAA'::BLOB, 1::UTINYINT, ''::BLOB, ''::BLOB),
 (2::UINTEGER, 0::UINTEGER, 105::UBIGINT, 115::UBIGINT, 1::TINYINT, 2::UINTEGER, 0::UBIGINT, NULL::UBIGINT, NULL::UBIGINT,
  NULL::BLOB, NULL::UTINYINT, NULL::BLOB, NULL::BLOB),
 (3::UINTEGER, 1::UINTEGER, 200::UBIGINT, 232::UBIGINT, -1::TINYINT, 3::UINTEGER, 3::UBIGINT, 203::UBIGINT, 229::UBIGINT,
  'ATGAAACCCGGGTTTTAA'::BLOB, 1::UTINYINT, 'GGG'::BLOB, 'TTT'::BLOB),
 (4::UINTEGER, 2::UINTEGER, 300::UBIGINT, 349::UBIGINT, 1::TINYINT, 4::UINTEGER, 3::UBIGINT, 300::UBIGINT, 349::UBIGINT,
  'ATGAAACCCGGGTTTAAACC'::BLOB, 1::UTINYINT, ''::BLOB, ''::BLOB),
 (5::UINTEGER, 2::UINTEGER, 400::UBIGINT, 449::UBIGINT, -1::TINYINT, 5::UINTEGER, 3::UBIGINT, 400::UBIGINT, 449::UBIGINT,
  'ATGAAACCCGGGTTTAAACC'::BLOB, 1::UTINYINT, ''::BLOB, ''::BLOB)
) t(transcript_index, seq_region, transcript_start, transcript_end, strand, gene_index, transcript_flags, cds_start, cds_end,
    cds_sequence, codon_table, pre_cds_sequence, post_cds_sequence);

statement ok
CREATE TABLE dc_ex AS SELECT * FROM (VALUES
 (0::UINTEGER, 100::UBIGINT, 110::UBIGINT, 1::UBIGINT, 11::UBIGINT, -1::TINYINT, 2::TINYINT),
 (0::UINTEGER, 120::UBIGINT, 132::UBIGINT, 12::UBIGINT, 24::UBIGINT, 2::TINYINT, -1::TINYINT),
 (1::UINTEGER, 104::UBIGINT, 108::UBIGINT, 1::UBIGINT, 5::UBIGINT, 0::TINYINT, 2::TINYINT),
 (1::UINTEGER, 125::UBIGINT, 131::UBIGINT, 6::UBIGINT, 12::UBIGINT, 2::TINYINT, 0::TINYINT),
 (2::UINTEGER, 105::UBIGINT, 115::UBIGINT, 1::UBIGINT, 11::UBIGINT, -1::TINYINT, -1::TINYINT),
 (3::UINTEGER, 220::UBIGINT, 232::UBIGINT, 1::UBIGINT, 13::UBIGINT, -1::TINYINT, 1::TINYINT),
 (3::UINTEGER, 200::UBIGINT, 210::UBIGINT, 14::UBIGINT, 24::UBIGINT, 1::TINYINT, -1::TINYINT),
 (4::UINTEGER, 300::UBIGINT, 309::UBIGINT, 1::UBIGINT, 10::UBIGINT, 0::TINYINT, 1::TINYINT),
 (4::UINTEGER, 340::UBIGINT, 349::UBIGINT, 11::UBIGINT, 20::UBIGINT, 1::TINYINT, 2::TINYINT),
 (5::UINTEGER, 440::UBIGINT, 449::UBIGINT, 1::UBIGINT, 10::UBIGINT, 0::TINYINT, 1::TINYINT),
 (5::UINTEGER, 400::UBIGINT, 409::UBIGINT, 11::UBIGINT, 20::UBIGINT, 1::TINYINT, 2::TINYINT)
) e(transcript_index, exon_start, exon_end, exon_cdna_start, exon_cdna_end, phase, end_phase);

query I
SELECT loaded FROM duckvep_model_load('dc', 'SELECT i::UINTEGER seq_region, 1000::UBIGINT sequence_length FROM range(3) t(i)',
 'SELECT * FROM dc_tx ORDER BY seq_region, transcript_start, transcript_index',
 'SELECT * FROM dc_ex ORDER BY transcript_index, exon_cdna_start',
 transcript_coverage_complete := TRUE);
----
1

# Exhaustive small events on both regions against the annotation builder: every position from 90 to 244 with a substitution,
# an MNV, deletions of 1 to 5 bases, insertions of 1 and 2 bases and indels that both delete and insert, each written as a
# VCF record with its shared anchor base. The scalar must return exactly the (event, transcript) pairs to which the annotation
# builder assigns the CDS region bit, no more (an anchor base alone never creates an overlap) and no fewer.

statement ok
CREATE TABLE dc_alleles AS SELECT * FROM (VALUES
 ('snv', 'A', 'C'), ('mnv', 'AG', 'CT'), ('del1', 'AC', 'A'), ('del2', 'ACG', 'A'), ('del3', 'ACGT', 'A'), ('del5', 'ACGTAC', 'A'),
 ('ins1', 'A', 'AT'), ('ins2', 'A', 'ATG'), ('indel', 'ACG', 'AT'), ('delins', 'ACG', 'TT')) v(shape, reference, alternate);

statement ok
CREATE TABLE dc_ev AS SELECT (row_number() OVER ())::UBIGINT event_index, r::UINTEGER seq_region, p::UBIGINT AS position,
 reference, alternate, NULL::UBIGINT end_position, NULL::VARCHAR structural_type, NULL::VARCHAR copy_change,
 NULL::UINTEGER mate_seq_region, NULL::UBIGINT mate_position
FROM range(0, 3) a(r), range(90, 440) b(p), dc_alleles;

statement ok
CREATE TABLE dc_annotated AS SELECT DISTINCT event_index, transcript_index
FROM query(duckvep_annotate_sql('dc_ev', 'dc')) WHERE region_mask & 16 <> 0;

statement ok
CREATE TABLE dc_found AS SELECT event_index, unnest(duckvep_coding_transcripts('dc', seq_region, position, reference, alternate)) AS transcript_index
FROM dc_ev;

query IIII
SELECT (SELECT count(*) FROM dc_ev), (SELECT count(*) FROM dc_annotated) > 100,
 (SELECT count(*) FROM dc_annotated a ANTI JOIN dc_found f USING (event_index, transcript_index)),
 (SELECT count(*) FROM dc_found f ANTI JOIN dc_annotated a USING (event_index, transcript_index));
----
10500	1	0	0

# Named cases. Plus strand (transcripts 0 and 1, region 0): CDS 103-129 in exons 100-110 and 120-132 (transcript 0), all of
# 104-108 and 125-131 (transcript 1); transcript 0's 9-base intron is a frameshift intron, which VEP counts as coding. A deletion
# whose anchor is the last CDS base and whose deleted bases are UTR is not a CDS event; a deletion anchored in the UTR that
# deletes CDS bases is; a deletion inside the short intron of transcript 0 is, and so is one anchored on its last base.

query IIII
SELECT duckvep_coding_transcripts('dc', 0, 129, 'AGG', 'A'), duckvep_coding_transcripts('dc', 0, 102, 'TAA', 'T'),
 duckvep_coding_transcripts('dc', 0, 110, 'AGG', 'A'), duckvep_coding_transcripts('dc', 0, 119, 'AGG', 'A');
----
[1]	[0, 1]	[0]	[0]

# Insertions after the last and before the first CDS base are UTR events for transcript 0 (transcript 1's CDS covers 129),
# an insertion between two CDS bases is a CDS event, and one at an internal coding exon's entrance (anchor on the last
# intron base) is placed on the exon's first base.

query IIII
SELECT duckvep_coding_transcripts('dc', 0, 129, 'A', 'AT'), duckvep_coding_transcripts('dc', 0, 102, 'A', 'AT'),
 duckvep_coding_transcripts('dc', 0, 106, 'T', 'TA'), duckvep_coding_transcripts('dc', 0, 119, 'A', 'AC');
----
[1]	[]	[0, 1]	[0]

# Longer introns (transcripts 4 and 5, exons 300-309 and 340-349, and 440-449 and 400-409): on the plus strand a deletion
# anchored on the last base of the first exon deletes only intron (not a CDS event), one anchored on the last intron base deletes
# the second exon's first bases (a CDS event), one anchored in the flank before the first CDS base deletes CDS bases (an event);
# the same shapes on the minus strand, where exon order is reversed, and insertions at the CDS start and end and inside an exon.

query IIIIII
SELECT duckvep_coding_transcripts('dc', 2, 309, 'AGG', 'A'), duckvep_coding_transcripts('dc', 2, 339, 'AGG', 'A'),
 duckvep_coding_transcripts('dc', 2, 299, 'TAA', 'T'), duckvep_coding_transcripts('dc', 2, 349, 'A', 'AT'),
 duckvep_coding_transcripts('dc', 2, 299, 'A', 'AT'), duckvep_coding_transcripts('dc', 2, 305, 'A', 'AT');
----
[]	[4]	[4]	[]	[]	[4]

query IIIIIIII
SELECT duckvep_coding_transcripts('dc', 2, 409, 'AGG', 'A'), duckvep_coding_transcripts('dc', 2, 439, 'AGG', 'A'),
 duckvep_coding_transcripts('dc', 2, 399, 'TAA', 'T'), duckvep_coding_transcripts('dc', 2, 449, 'A', 'AT'),
 duckvep_coding_transcripts('dc', 2, 399, 'A', 'AT'), duckvep_coding_transcripts('dc', 2, 445, 'A', 'AT'),
 duckvep_coding_transcripts('dc', 2, 449, 'AGG', 'A'), duckvep_coding_transcripts('dc', 2, 448, 'AGG', 'A');
----
[]	[5]	[5]	[]	[]	[5]	[]	[5]

# Transcript 3 (minus strand, region 1, short intron 211-219 that VEP counts as coding): an anchor at the start codon's base 229
# deleting UTR is not a CDS event, a deletion anchored in the UTR that removes CDS bases is, a deletion inside the short intron is,
# and insertions at either outer CDS edge are UTR.

query IIIIIII
SELECT duckvep_coding_transcripts('dc', 1, 229, 'TCC', 'T'), duckvep_coding_transcripts('dc', 1, 202, 'GAA', 'G'),
 duckvep_coding_transcripts('dc', 1, 203, 'AGG', 'A'), duckvep_coding_transcripts('dc', 1, 210, 'AGG', 'A'),
 duckvep_coding_transcripts('dc', 1, 229, 'T', 'TA'), duckvep_coding_transcripts('dc', 1, 202, 'A', 'AT'),
 duckvep_coding_transcripts('dc', 1, 205, 'A', 'AT');
----
[]	[3]	[3]	[3]	[]	[]	[3]

# A substitution touches only its own base; a deletion is its deleted bases, not its anchor; an event identical to REF, a
# symbolic ALT and a missing ALT are not events.

query IIIIII
SELECT duckvep_coding_transcripts('dc', 0, 103, 'A', 'C'), duckvep_coding_transcripts('dc', 0, 102, 'A', 'C'),
 duckvep_coding_transcripts('dc', 0, 103, 'A', 'A'), duckvep_coding_transcripts('dc', 0, 104, 'A', '<DEL>'),
 duckvep_coding_transcripts('dc', 0, 104, 'A', '*'), duckvep_coding_transcripts('dc', 0, 104, 'A', 'ACGT');
----
[0]	[]	[]	[]	[]	[0, 1]

# Wrong region, region outside the model, NULL arguments.

query IIIIIII
SELECT duckvep_coding_transcripts('dc', 2, 105, 'A', 'C'), duckvep_coding_transcripts('dc', 9, 105, 'A', 'C'),
 duckvep_coding_transcripts('dc', -1, 105, 'A', 'C'), duckvep_coding_transcripts('dc', NULL, 105, 'A', 'C') IS NULL,
 duckvep_coding_transcripts('dc', 0, NULL, 'A', 'C') IS NULL, duckvep_coding_transcripts(NULL, 0, 105, 'A', 'C') IS NULL,
 duckvep_coding_transcripts('dc', 0, 105, NULL, 'C') IS NULL;
----
[]	[]	[]	true	true	true	true

# Integer arguments of any width and signedness work (the numeric parameters are HUGEINT), including sums that DuckDB
# widens. A region beyond the model's range simply has no transcripts.

query IIIII
SELECT duckvep_coding_transcripts('dc', 0::UINTEGER, 104::UBIGINT, 'A', 'C'),
 duckvep_coding_transcripts('dc', 1::SMALLINT, 205::INTEGER, 'A', 'C'),
 duckvep_coding_transcripts('dc', 0::TINYINT, 106::USMALLINT, 'A', 'C'),
 duckvep_coding_transcripts('dc', 0, 106::UBIGINT + 1, 'A', 'C'),
 duckvep_coding_transcripts('dc', 170141183460469231731687303715884105727::HUGEINT, 106, 'A', 'C');
----
[0, 1]	[3]	[0, 1]	[0, 1]	[]

# Errors: unknown model, malformed positions and alleles.

statement error
SELECT duckvep_coding_transcripts('nope', 0, 105, 'A', 'C');
----
unknown model name

statement error
SELECT duckvep_coding_transcripts('dc', 0, 0, 'A', 'C');
----
position must be from 1

statement error
SELECT duckvep_coding_transcripts('dc', 0, 3000000000, 'A', 'C');
----
2147483647

statement error
SELECT duckvep_coding_transcripts('dc', 0, 1, 'A', repeat('A', 70000));
----
at most 65535 bases

# The scalar composes with the haplotype builder: discovery output is the calls relation's transcript_index.

statement ok
CREATE TABLE dc_records AS SELECT * FROM (VALUES
 (1::BIGINT, 0::INTEGER, 106::BIGINT, 'T', 'C', [1, 0]::INTEGER[], [false, true]::BOOLEAN[]),
 (2::BIGINT, 0::INTEGER, 300::BIGINT, 'T', 'C', [1, 0]::INTEGER[], [false, true]::BOOLEAN[]),
 (3::BIGINT, 1::INTEGER, 205::BIGINT, 'T', 'C', [0, 1]::INTEGER[], [false, true]::BOOLEAN[])
) v(event_index, seq_region, position, reference, alternate, alleles, phase_before);

query III
SELECT count(*), count(DISTINCT event_index), count(DISTINCT transcript_index) FROM (
 SELECT r.event_index, unnest(duckvep_coding_transcripts('dc', r.seq_region, r.position, r.reference, r.alternate)) transcript_index
 FROM dc_records r);
----
3	2	3

statement ok
SELECT duckvep_model_drop('dc');

# name: test/sql/duckvep_load.test
# description: Caller-owned macro and read-only attached catalog
# group: [duckvep]

statement ok
CREATE MACRO duckvep_annotate(x) AS x || ':caller';

require duckvep

query T
SELECT duckvep_annotate('kept');
----
kept:caller

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_type = 'macro' AND function_name LIKE 'duckvep_%';
----
1

statement ok
ATTACH '__TEST_DIR__/duckvep_load.duckdb' AS gate;

statement ok
CREATE OR REPLACE TABLE gate.caller_data AS SELECT 42 AS value;

statement ok
DETACH gate;

statement ok
ATTACH '__TEST_DIR__/duckvep_load.duckdb' AS gate (READ_ONLY);

query I
SELECT value FROM gate.caller_data;
----
42

statement ok
DETACH gate;

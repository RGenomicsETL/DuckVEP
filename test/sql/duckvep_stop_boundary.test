# name: test/sql/duckvep_stop_boundary.test
# description: Deletions at a stop codon, with and without an exon junction inside it
# group: [duckvep]

require duckvep

# STOP1 has an unsplit stop codon. STOP2 splits it as TG|A across an intron
# that starts with G. STOP3 starts its last exon inside the last sense codon,
# after an intron that ends with G.
statement ok
CREATE TABLE stop_sources AS SELECT * FROM (VALUES
  (0, 'STOP1', 1600, 1518, 'ATGGCCGCCATCGACTGA',
   'TTGAGCCTTTATGAGAGGTGTGTATTCCCCGTCTAGAAAGGCAATAGGATGGCCTAAGGTGACTAGGCGGTTTATGGTGAGT'),
  (1, 'STOP2', 1660, 1618, 'ATGGCCGCCGCAAAATGA',
   'AATTGTGAGGAACTATCAGAGGGACCAGTGCTAGAGGACATA'),
  (2, 'STOP3', 1660, 1621, 'ATGGCCGCCGCAGAAGTGTGA',
   'ATTTTAGACATAAGGTTTAATATATTTGTGCCCCTGCGA')
) s(i, name, transcript_end, cds_end, cds, post);

statement ok
CREATE TABLE stop_exons AS SELECT * FROM (VALUES
  (0, 1501, 1600, 1, 100, 0, -1),
  (1, 1501, 1517, 1, 17, 0, 2), (1, 1618, 1660, 18, 60, 2, -1),
  (2, 1501, 1516, 1, 16, 0, 1), (2, 1617, 1660, 17, 60, 1, -1)
) e(i, exon_start, exon_end, cdna_start, cdna_end, phase, end_phase);

query I
SELECT loaded FROM duckvep_model_load('stop-boundary',
  'SELECT i::UINTEGER seq_region, 2000::UBIGINT sequence_length, name seq_region_name FROM stop_sources ORDER BY i',
  'SELECT i::UINTEGER transcript_index, i::UINTEGER seq_region, 1501::UBIGINT transcript_start, transcript_end::UBIGINT transcript_end, 1::TINYINT strand, i::UINTEGER gene_index, 3::UBIGINT transcript_flags, 1501::UBIGINT cds_start, cds_end::UBIGINT cds_end, cds::BLOB cds_sequence, 1::UTINYINT codon_table, ''''::BLOB pre_cds_sequence, post::BLOB post_cds_sequence FROM stop_sources ORDER BY i',
  'SELECT i::UINTEGER transcript_index, exon_start::UBIGINT exon_start, exon_end::UBIGINT exon_end, cdna_start::UBIGINT exon_cdna_start, cdna_end::UBIGINT exon_cdna_end, phase::TINYINT phase, end_phase::TINYINT end_phase FROM stop_exons ORDER BY i, cdna_start',
  reference_fasta := '__WORKING_DIRECTORY__/test/data/duckvep/stop_boundary.fa');
----
1

statement ok
CREATE TABLE stop_events AS SELECT row_number() OVER (ORDER BY seq_region, position, reference)::UBIGINT event_index,
  seq_region::UINTEGER seq_region, position::UBIGINT position, reference, alternate,
  NULL::UBIGINT end_position, NULL::VARCHAR structural_type, NULL::VARCHAR copy_change,
  NULL::UINTEGER mate_seq_region, NULL::UBIGINT mate_position
FROM (VALUES (0, 1511, 'TCGAC', 'T'), (0, 1516, 'TGA', 'T'),
             (1, 1515, 'AT', 'A'), (1, 1516, 'TG', 'T'),
             (2, 1615, 'AGT', 'A'), (2, 1618, 'GTG', 'G')) v(seq_region, position, reference, alternate);

# VEP 116.0 on its GFF path gives the same six rows. Row 1 leaves every residue
# through the stop unchanged. Row 4 deletes a stop base that lies outside the
# three unspliced genomic bases VEP tests for stop overlap.
query ITTTTI
SELECT event_index, consequence, transcript_hgvs, protein_hgvs, protein_hgvs_status, coalesce(hgvs_shift, 0)
FROM query(duckvep_annotate_sql('stop_events', 'stop-boundary', struct_pack(
  rich := true, hgvs := true, upstream_distance := 0, downstream_distance := 0)))
ORDER BY event_index;
----
1	frameshift_variant	c.12_15del	p.Ter6=	supported	0
2	stop_lost	c.17_18del	p.Ter6=	supported	0
3	stop_lost&splice_region_variant	c.16del	p.Ter6=	supported	0
4	splice_region_variant&coding_sequence_variant	c.17del	p.Ter6=	supported	0
5	splice_acceptor_variant&coding_sequence_variant	c.17-1_17del	NULL	not_applicable	0
6	stop_lost&splice_region_variant	c.20_21del	p.Ter7=	supported	1

query I
SELECT duckvep_model_drop('stop-boundary');
----
1

require duckvep

# Two closed CDS models have explicit code 1 and annotated coding boundaries.
query T
SELECT loaded FROM duckvep_model_load('annotated_initiation',
 'SELECT i::UINTEGER seq_region FROM range(4) t(i)',
 'SELECT i::UINTEGER transcript_index,i::UINTEGER seq_region,100::UBIGINT transcript_start,
  123::UBIGINT transcript_end,CASE WHEN i=1 THEN -1 ELSE 1 END::TINYINT strand,
  i::UINTEGER gene_index,0::UBIGINT transcript_flags,100::UBIGINT cds_start,123::UBIGINT cds_end,
  (CASE WHEN i=1 THEN ''TTG'' WHEN i=3 THEN ''NTG'' ELSE ''CTG'' END ||
  ''GCTGAACTGAAACGCAGCTAA'')::BLOB cds_sequence,1::UTINYINT codon_table,
  ''''::BLOB pre_cds_sequence,''''::BLOB post_cds_sequence,NULL::BLOB cdna_sequence
  FROM range(4) t(i)',
 'SELECT i::UINTEGER transcript_index,100::UBIGINT exon_start,123::UBIGINT exon_end,
  1::UBIGINT exon_cdna_start,24::UBIGINT exon_cdna_end,0::TINYINT phase,0::TINYINT end_phase
  FROM range(4) t(i)')
----
true

statement ok
CREATE TABLE annotated_calls AS SELECT * FROM (VALUES
  (1::BIGINT,0::INTEGER,100::BIGINT,'C','T',1::INTEGER,0::INTEGER),
  (2,1,123,'A','G',1,1),
  (3,0,103,'G','A',1,0),
  (4,1,120,'C','T',1,1),
  (5,0,101,'T','C',1,0),
  (6,2,103,'G','A',1,2),
  (7,3,103,'G','A',1,3)
) t(event_index,seq_region,position,reference,alternate,alt_index,transcript_index),
LATERAL (SELECT event_index::INTEGER sample_index,[1,0]::INTEGER[] alleles,
 [false,true]::BOOLEAN[] phase_before, NULL::BIGINT phase_set) gt

query IITTT
SELECT transcript_index,c.sample_index,c.prediction_status,prediction_reason,
 array_to_string(list_sort(c.haplotype_consequences),',')
FROM (SELECT transcript_index,prediction_reason,unnest(carrier_predictions) c
 FROM duckvep_haplotypes('SELECT * FROM annotated_calls','annotated_initiation'))
ORDER BY transcript_index,c.sample_index
----
0	1	predicted	supported_domain	start_retained_variant,synonymous_variant
0	3	predicted	supported_domain	missense_variant
0	5	predicted	supported_domain	start_lost
1	2	predicted	supported_domain	start_retained_variant,synonymous_variant
1	4	predicted	supported_domain	missense_variant
2	6	predicted	supported_domain	missense_variant
3	7	unsupported_context	noncanonical_start	NULL

query IITTTTT
SELECT transcript_index,c.sample_index,cds,protein,hgvsp,prediction_reference_protein,
 list_transform(contributors, lambda v: v.event_index)::VARCHAR
FROM (SELECT transcript_index,CAST(cds AS VARCHAR) cds,protein,hgvsp,prediction_reference_protein,
 contributors,unnest(carrier_predictions) c FROM duckvep_haplotypes(
 'SELECT * FROM annotated_calls','annotated_initiation'))
WHERE c.sample_index IN (1,2,3,4,5) ORDER BY transcript_index,c.sample_index
----
0	1	TTGGCTGAACTGAAACGCAGCTAA	LAELKRS*	NULL	NULL	[1]
0	3	CTGACTGAACTGAAACGCAGCTAA	LTELKRS*	NULL	NULL	[3]
0	5	CCGGCTGAACTGAAACGCAGCTAA	PAELKRS*	NULL	NULL	[5]
1	2	CTGGCTGAACTGAAACGCAGCTAA	LAELKRS*	NULL	NULL	[2]
1	4	TTGACTGAACTGAAACGCAGCTAA	LTELKRS*	NULL	NULL	[4]
